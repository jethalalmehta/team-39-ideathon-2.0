    content: "import React, { useState } from \'react\';\nimport { ProgressSummary, RejectionRecord } from \'../types\';\nimport { initialRejections, initialProgress } from \'../data/mockData\';\nimport { HeartHandshake, Lightbulb, Target, Plus, CheckCircle, ArrowRight, ShieldCheck } from \'lucide-react\';\n\ninterface ProgressPageProps {\n  onStartAptitudePractice?: () => void;\n  onNavigateToPrepare?: () => void;\n}\n\nexport const ProgressPage: React.FC<ProgressPageProps> = ({\n  onStartAptitudePractice,\n  onNavigateToPrepare,\n}) => {\n  const [progress, setProgress] = useState<ProgressSummary>(initialProgress);\n  const [rejections, setRejections] = useState<RejectionRecord[]>(initialRejections);\n  const [showLogModal, setShowLogModal] = useState(false);\n  const [newCompany, setNewCompany] = useState(\'\');\n  const [newStage, setNewStage] = useState<\'Aptitude / Online Test\' | \'Technical Round 1\' | \'Technical Round 2\' | \'HR Round\'>(\'Aptitude / Online Test\');\n  const [newNote, setNewNote] = useState(\'\');\n  const [loggedNotification, setLoggedNotification] = useState(false);\n\n  const handleAddLog = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newCompany.trim()) return;\n\n    const newRecord: RejectionRecord = {\n      id: `rej-${Date.now()}`,\n      company: newCompany.trim(),\n      role: \'Graduate Software Engineer\',\n      stage: newStage,\n      date: \'Just now\',\n      primaryCause: newNote.trim() || \'Speed on timed problem solving\',\n      takeaway: \'Focus practice on the bottleneck segment.\',\n    };\n\n    setRejections([newRecord, ...rejections]);\n    setProgress((prev) => ({\n      ...prev,\n      rejections: prev.rejections + 1,\n    }));\n    setNewCompany(\'\');\n    setNewNote(\'\');\n    setShowLogModal(false);\n    setLoggedNotification(true);\n    setTimeout(() => setLoggedNotification(false), 3000);\n  };\n\n  return (\n    <section className=\"py-8 sm:py-12 bg-[#fcf8ff]\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-[#e5deff] border border-[#c8c0f7] rounded-full text-xs font-semibold text-[#170065] mb-2\">\n              <span>Placement Tracker</span>\n              <span className=\"text-[#8174e5]\">\302\267</span>\n              <span>Constructive Insights</span>\n            </div>\n            <h1 className=\"text-3xl sm:text-4xl font-black text-[#09090D] tracking-tight\">"
    num_lines: 371
