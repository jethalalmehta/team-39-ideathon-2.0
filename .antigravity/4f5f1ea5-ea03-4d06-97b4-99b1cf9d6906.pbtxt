    thinking: "**Constructing Opportunity View**\n\nI\'m now focused on building the `OpportunityModal.tsx` component. My goal is to create a clear, detailed display for each opportunity. It will highlight the company and role, along with a match score visualization and explanation. An easy-to-understand eligibility breakdown and a comprehensive rounds breakdown will also be included.\n\n\n"
    tool_calls {
      id: "call_497632"
      name: "create_file"
      arguments_json: "{\"Content\":\"import React from \'react\';\\nimport { X, Clock, MapPin, Briefcase, CheckCircle, ArrowRight, Sparkles } from \'lucide-react\';\\nimport { Opportunity } from \'../types\';\\nimport { MatchRing } from \'./MatchRing\';\\nimport { EligibilityBadge } from \'./EligibilityBadge\';\\n\\ninterface OpportunityModalProps {\\n  opportunity: Opportunity | null;\\n  onClose: () => void;\\n  onPrepare: (opp: Opportunity) => void;\\n  onToggleApplied: (oppId: string) => void;\\n}\\n\\nexport const OpportunityModal: React.FC<OpportunityModalProps> = ({\\n  opportunity,\\n  onClose,\\n  onPrepare,\\n  onToggleApplied,\\n}) => {\\n  if (!opportunity) return null;\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#09090D]/60 backdrop-blur-xs animate-in fade-in\\\"\\n      onClick={onClose}\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-labelledby=\\\"modal-job-title\\\"\\n    >\\n      <div\\n        onClick={(e) => e.stopPropagation()}\\n        className=\\\"w-full max-w-2xl bg-[#fcf8ff] rounded-2xl border border-[#c8c0f7] shadow-2xl overflow-hidden max-h-[90vh] flex flex-col animate-in zoom-in-95 duration-150\\\"\\n      >\\n        {/* Modal Top Bar */}\\n        <div className=\\\"flex items-center justify-between px-6 py-4 border-b border-[#e5e0f4] bg-[#f1ebff]\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <span className=\\\"text-xs font-bold uppercase tracking-wider text-[#5f5888]\\\">\\n              {opportunity.source}\\n            </span>\\n            <span className=\\\"text-[#968DC8]\\\">\302\267</span>\\n            <span className=\\\"text-xs text-[#78767b] font-mono-code\\\">\\n              {opportunity.type}\\n            </span>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"p-1 text-[#47464b] hover:text-[#09090D] hover:bg-[#ebe5fa] rounded-lg transition-colors\\\"\\n            aria-label=\\\"Close dialog\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Modal Body */}\\n        <div className=\\\"p-6 overflow-y-auto space-y-6\\\">\\n          {/* Main Job Title & Match Banner */}\\n          <div className=\\\"flex items-start justify-between gap-4\\\">\\n            <div>\\n              <span className=\\\"text-sm font-bold text-[#5f5888] uppercase tracking-wide\\\">\\n                {opportunity.company}\\n              </span>\\n              <h2\\n                id=\\\"modal-job-title\\\"\\n                className=\\\"text-2xl sm:text-3xl font-black text-[#09090D] tracking-tight mt-0.5\\\"\\n              >\\n                {opportunity.role}\\n              </h2>\\n              <div className=\\\"flex flex-wrap items-center gap-3 mt-2 text-xs font-medium text-[#47464b]\\\">\\n                <span className=\\\"font-bold text-[#170065] text-sm font-mono-code bg-[#e5deff] px-2 py-0.5 rounded\\\">\\n                  {opportunity.ctc}\\n                </span>\\n                <span className=\\\"flex items-center gap-1\\\">\\n                  <MapPin className=\\\"w-3.5 h-3.5 text-[#5f5888]\\\" />\\n                  {opportunity.location}\\n                </span>\\n                <span className=\\\"flex items-center gap-1\\\">\\n                  <Clock className=\\\"w-3.5 h-3.5 text-[#5f5888]\\\" />\\n                  {opportunity.deadline}\\n                </span>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"shrink-0 bg-white p-2 rounded-2xl border border-[#d1c8ff] shadow-sm\\\">\\n              <MatchRing score={opportunity.matchScore} size=\\\"lg\\\" />\\n            </div>\\n          </div>\\n\\n          {/* Eligibility Section (Always visible, unambiguous) */}\\n          <div className=\\\"bg-[#f1ebff] p-4 rounded-xl border border-[#d1c8ff]\\\">\\n            <div className=\\\"text-xs font-bold uppercase tracking-wider text-[#5f5888] mb-2\\\">\\n              Eligibility Verification\\n            </div>\\n            <EligibilityBadge eligibility={opportunity.eligibility} showDetails={true} />\\n            <div className=\\\"mt-3 pt-3 border-t border-[#d1c8ff]/60 grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs\\\">\\n              <div>\\n                <span className=\\\"text-[#78767b] block text-[11px]\\\">Required CGPA</span>\\n                <span className=\\\"font-bold text-[#09090D] font-mono-code\\\">{opportunity.eligibility.minCgpa} minimum</span>\\n              </div>\\n              <div>\\n                <span className=\\\"text-[#78767b] block text-[11px]\\\">Eligible Branches</span>\\n                <span className=\\\"font-bold text-[#09090D]\\\">{opportunity.eligibility.allowedBranches.join(\', \')}</span>\\n              </div>\\n              <div>\\n                <span className=\\\"text-[#78767b] block text-[11px]\\\">Active Backlogs</span>\\n                <span className=\\\"font-bold text-[#09090D]\\\">{opportunity.eligibility.backlogsAllowed ? \'Allowed\' : \'Strictly 0\'}</span>\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Description */}\\n          <div>\\n            <h4 className=\\\"text-xs font-bold text-[#5f5888] uppercase tracking-wider mb-1.5\\\">\\n              Role Overview\\n            </h4>\\n            <p className=\\\"text-sm text-[#23212E] leading-relaxed\\\">\\n              {opportunity.description}\\n            </p>\\n          </div>\\n\\n          {/* Selection Rounds */}\\n          <div>\\n            <h4 className=\\\"text-xs font-bold text-[#5f5888] uppercase tracking-wider mb-2\\\">\\n              Selection Rounds (TPO Structure)\\n            </h4>\\n            <div className=\\\"space-y-2\\\">\\n              {opportunity.rounds.map((round, idx) => (\\n                <div\\n                  key={idx}\\n                  className=\\\"flex items-center gap-3 p-2.5 bg-white rounded-lg border border-[#e5e0f4] text-xs font-medium text-[#1c1a28]\\\"\\n                >\\n                  <span className=\\\"w-5 h-5 rounded-full bg-[#09090D] text-[#E3E0F2] flex items-center justify-center font-mono-code text-[11px] shrink-0 font-bold\\\">\\n                    {idx + 1}\\n                  </span>\\n                  <span>{round}</span>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n\\n          {/* Skills Required */}\\n          <div>\\n            <h4 className=\\\"text-xs font-bold text-[#5f5888] uppercase tracking-wider mb-1.5\\\">\\n              Core Skills Tested\\n            </h4>\\n            <div className=\\\"flex flex-wrap gap-2 text-xs font-mono-code\\\">\\n              {opportunity.skills.map((skill) => (\\n                <span\\n                  key={skill}\\n                  className=\\\"bg-white border border-[#c8c0f7] text-[#09090D] px-2.5 py-1 rounded-md font-medium\\\"\\n                >\\n                  {skill}\\n                </span>\\n              ))}\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Modal Footer with One Clear Primary Action */}\\n        <div className=\\\"p-4 sm:p-5 border-t border-[#e5e0f4] bg-[#f1ebff] flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3\\\">\\n          <button\\n            onClick={() => onToggleApplied(opportunity.id)}\\n            className={`px-4 py-2 text-xs font-semibold rounded-lg border transition-colors inline-flex items-center justify-center gap-1.5 ${\\n              opportunity.applied\\n                ? \'bg-[#e5deff] text-[#170065] border-[#c8c0f7]\'\\n                : \'bg-white text-[#47464b] hover:text-[#09090D] border-[#c8c5cb]\'\\n            }`}\\n          >\\n            <CheckCircle className=\\\"w-4 h-4\\\" />\\n            <span>{opportunity.applied ? \'Applied (Click to undo)\' : \'Mark as Applied\'}</span>\\n          </button>\\n\\n          <button\\n            onClick={() => {\\n              onClose();\\n              onPrepare(opportunity);\\n            }}\\n            className=\\\"px-6 py-2.5 bg-[#09090D] hover:bg-[#1b1b1f] text-[#E3E0F2] text-xs font-bold rounded-lg nexora-btn-press shadow-md transition-colors inline-flex items-center justify-center gap-2\\\"\\n          >\\n            <Sparkles className=\\\"w-4 h-4 text-[#7568D8]\\\" />\\n            <span>Prepare for this job in Grill</span>\\n            <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/OpportunityModal.tsx\", \"toolAction\":\"Creating OpportunityModal.tsx\", \"toolSummary\":\"Implement focused opportunity detail modal\"}"
