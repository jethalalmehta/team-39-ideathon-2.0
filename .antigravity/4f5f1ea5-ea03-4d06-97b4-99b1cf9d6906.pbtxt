    }
    model_usage {
      input_tokens: 5950
      output_tokens: 3710
      cache_read_tokens: 86004
      message_id: "9UvHavreKOy4qtsPhs3UMA"
      thinking_output_tokens: 1141
      response_output_tokens: 2569
      response_id: "9UvHavreKOy4qtsPhs3UMA"
