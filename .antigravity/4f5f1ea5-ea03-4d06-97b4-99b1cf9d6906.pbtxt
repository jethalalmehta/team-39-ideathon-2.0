  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 139
    content: "import React, { useState, useMemo, useRef } from \'react\';\nimport { initialOpportunities, initialStudentProfile } from \'./data/mockData\';\nimport { Opportunity, StudentProfile } from \'./types\';\nimport { Navbar, NavTab } from \'./components/Navbar\';\nimport { HeroSection } from \'./components/HeroSection\';\nimport { JourneyFlow } from \'./components/JourneyFlow\';\nimport { OpportunityFeed } from \'./components/OpportunityFeed\';\nimport { OpportunityModal } from \'./components/OpportunityModal\';\nimport { PlacementInboxModal } from \'./components/PlacementInboxModal\';\nimport { CompanySearchPage } from \'./components/CompanySearchPage\';\nimport { ResumeGrill } from \'./components/ResumeGrill\';\nimport { ProgressPage } from \'./components/ProgressPage\';\nimport { StudentProfileModal } from \'./components/StudentProfileModal\';\nimport { CursorGlow } from \'./components/CursorGlow\';\nimport { Footer } from \'./components/Footer\';\nimport { CheckCircle2 } from \'lucide-react\';\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<NavTab>(\'opportunities\');\n  const [student, setStudent] = useState<StudentProfile>(initialStudentProfile);\n  const [rawOpportunities, setRawOpportunities] = useState<Opportunity[]>(initialOpportunities);\n  \n  const [selectedOpportunityModal, setSelectedOpportunityModal] = useState<Opportunity | null>(null);\n  const [grillTargetOpportunity, setGrillTargetOpportunity] = useState<Opportunity | null>(null);\n  \n  const [isInboxOpen, setIsInboxOpen] = useState(false);\n  const [isProfileOpen, setIsProfileOpen] = useState(false);\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  const feedRef = useRef<HTMLDivElement>(null);\n\n  const triggerToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => {\n      setToastMessage(null);\n    }, 3500);\n  };\n\n  // Dynamically calculate eligibility and match score against current student profile\n  const opportunities = useMemo(() => {\n    return rawOpportunities.map((opp) => {\n      const minCgpa = opp.eligibility.minCgpa;\n      const isCgpaMet = student.cgpa >= minCgpa;\n      const isBranchMet = opp.eligibility.allowedBranches.some((b) =>\n        student.branch.toLowerCase().includes(b.toLowerCase()) || b === \'CSE\'\n      );\n      const hasBacklogs = student.activeBacklogs > 0;\n\n      let status: \'eligible\' | \'borderline\' | \'not_eligible\' = \'eligible\';\n      const reasons: string[] = [];\n\n      if (!isCgpaMet) {\n        status = \'not_eligible\';\n        reasons.push(`Minimum CGPA: ${minCgpa} \302\267 Your CGPA: ${student.cgpa}`);\n      } else if (student.cgpa - minCgpa < 0.25) {\n        status = \'borderline\';\n        reasons.push(`CGPA (${student.cgpa}) is close to cutoff line (${minCgpa}). Apply early.`);\n      } else {\n        reasons.push(`Your CGPA (${student.cgpa}) meets the ${minCgpa} requirement.`);\n      }\n\n      if (!isBranchMet) {\n        status = \'not_eligible\';\n        reasons.push(`Allowed branches: ${opp.eligibility.allowedBranches.join(\', \')} \302\267 Your branch: ${student.branch}`);\n      }\n\n      if (hasBacklogs && !opp.eligibility.backlogsAllowed) {\n        status = \'not_eligible\';\n        reasons.push(`0 active backlogs required for this drive.`);\n      }\n\n      // Dynamic match score\n      let matchScore = 80;\n      if (status === \'eligible\') {\n        matchScore = Math.min(97, Math.max(78, 85 + Math.round((student.cgpa - minCgpa) * 8)));\n      } else if (status === \'borderline\') {\n        matchScore = 78;\n      } else {\n        matchScore = Math.max(45, Math.round(70 - (minCgpa - student.cgpa) * 15));\n      }\n\n      return {\n        ...opp,\n        matchScore,\n        eligibility: {\n          ...opp.eligibility,\n          status,\n          reasons,\n          userCgpa: student.cgpa,\n          userBranch: student.branch,\n          hasActiveBacklogs: hasBacklogs,\n        },\n      };\n    });\n  }, [rawOpportunities, student]);\n\n  const eligibleCount = useMemo(() => {\n    return opportunities.filter((o) => o.eligibility.status === \'eligible\').length;\n  }, [opportunities]);\n\n  // Handle saving newly parsed opportunity from Placement Inbox\n  const handleSaveOpportunity = (newOpp: Opportunity) => {\n    setRawOpportunities((prev) => [newOpp, ...prev]);\n    triggerToast(`Added \"${newOpp.company} \342\200\224 ${newOpp.role}\" to your opportunities feed.`);\n    setActiveTab(\'opportunities\');\n    setTimeout(() => {\n      feedRef.current?.scrollIntoView({ behavior: \'smooth\' });\n    }, 100);\n  };\n\n  // Toggle application status\n  const handleToggleApplied = (oppId: string) => {\n    setRawOpportunities((prev) =>\n      prev.map((opp) => {\n        if (opp.id === oppId) {\n          const nextApplied = !opp.applied;\n          triggerToast(\n            nextApplied\n              ? `Marked ${opp.company} as Applied! Track it in Progress.`\n              : `Removed applied status for ${opp.company}.`\n          );\n          return {\n            ...opp,\n            applied: nextApplied,\n            applicationDate: nextApplied ? \'Applied just now\' : undefined,\n          };\n        }\n        return opp;\n      })\n    );\n\n    if (selectedOpportunityModal && selectedOpportunityModal.id === oppId) {\n      setSelectedOpportunityModal((prev) =>\n        prev\n          ? {\n              ...prev,\n              applied: !prev.applied,\n            }\n          : null\n      );"
    num_lines: 285
    num_bytes: 9840
  }
}
