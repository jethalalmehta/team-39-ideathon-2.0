mpany: \'Razorpay\',\n        role: \'Frontend Engineer 1\',\n        type: \'Full-time\',\n        ctc: \'\342\202\27119 LPA\',\n        location: \'Bengaluru\',\n        deadline: \'Closes in 7 days\',\n        deadlineDays: 7,\n        matchScore: 90,\n        eligibility: {\n          status: \'eligible\',\n          reasons: [\'Your CGPA (7.8) is above 7.0 cutoff.\', \'CSE approved.\', \'No active backlogs.\'],\n          minCgpa: 7.0,\n          userCgpa: 7.8,\n          allowedBranches: [\'CSE\', \'IT\'],\n          userBranch: \'CSE\',\n          backlogsAllowed: false,\n          hasActiveBacklogs: false,\n        },\n        skills: [\'React\', \'JavaScript / TypeScript\', \'Web Performance\', \'State Management\'],\n        rounds: [\'Machine Coding Round (Build an interactive component)\', \'Tech Deep Dive (DOM internals & Network)\', \'Bar Raiser\'],\n        description: \'Build fast, accessible checkout UI suites executed millions of times daily across web and mobile.\',\n        source: \'Campus Portal\',\n      },\n    ],\n  },\n  {\n    id: \'comp-google\',\n    name: \'Google\',\n    category: \'Big Tech / Search & AI\',\n    headquarters: \'Mountain View, CA \302\267 India: Bengaluru / Hyderabad\',\n    tier: \'Tier-1 Day 0\',\n    overview: \'Global leader in search, Android runtime, cloud infrastructure, YouTube video systems, and Gemini AI.\',\n    roles: [\n      initialOpportunities[3], // SWE Early Career\n      {\n        id: \'opp-goog-step\',\n        company: \'Google\',\n        role: \'STEP Intern 2026\',\n        type: \'Internship\',\n        ctc: \'\342\202\2711,15,000 / month\',\n        location: \'Bengaluru\',\n        deadline: \'Closes in 2 days\',\n        deadlineDays: 2,\n        matchScore: 72,\n        eligibility: {\n          status: \'not_eligible\',\n          reasons: [\'Minimum CGPA: 8.0 \302\267 Your CGPA: 7.8 (Missed cutoff by 0.2 CGPA).\'],\n          minCgpa: 8.0,\n          userCgpa: 7.8,\n          allowedBran