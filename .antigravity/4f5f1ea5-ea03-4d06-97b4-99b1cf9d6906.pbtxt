          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      question: \'In a high-concurrency FastAPI service querying PostgreSQL, what occurs if endpoints do not release connections back to the connection pool upon unexpected exceptions?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        { key: \'A\', text: \'PostgreSQL automatically terminates idle transactions after 50 milliseconds.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        { key: \'B\', text: \'Pool connections exhaust rapidly, causing subsequent concurrent client requests to hang and time out with HTTP 504 errors.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        { key: \'C\', text: \'FastAPI dynamically spawns extra CPU threads to duplicate the database connection pool.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        { key: \'D\', text: \'PostgreSQL switches automatically into in-memory read-only replica mode.\' },"
