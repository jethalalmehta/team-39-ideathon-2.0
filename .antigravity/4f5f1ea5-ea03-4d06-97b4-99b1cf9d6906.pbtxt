    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, ArrowRight, CheckCircle2, AlertTriangle, Sparkles, RefreshCw, Copy, Check } from \'lucide-react\';\nimport { Opportunity, StudentProfile, EligibilityDetail } from \'../types\';\nimport { MatchRing } from \'./MatchRing\';\nimport { EligibilityBadge } from \'./EligibilityBadge\';\nimport { sampleNotices } from \'../data/mockData\';\n\ninterface PlacementInboxModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onSaveOpportunity: (opp: Opportunity) => void;\n  student: StudentProfile;\n}\n\ntype Step = \'input\' | \'processing\' | \'preview\' | \'error\';\n\nexport const PlacementInboxModal: React.FC<PlacementInboxModalProps> = ({\n  isOpen,\n  onClose,\n  onSaveOpportunity,\n  student,\n}) => {\n  const [step, setStep] = useState<Step>(\'input\');\n  const [noticeText, setNoticeText] = useState(\'\');\n  const [processingStage, setProcessingStage] = useState(0);\n  const [parsedPreview, setParsedPreview] = useState<Opportunity | null>(null);\n  const [copiedSampleIdx, setCopiedSampleIdx] = useState<number | null>(null);\n\n  if (!isOpen) return null;\n\n  const processingSteps = [\n    \'Reading notice...\',\n    \'Finding requirements...\',\n    \'Checking eligibility...\',\n    \'Building your match...\',\n  ];\n\n  const handleProcessNotice = () => {\n    if (!noticeText.trim() || noticeText.trim().length < 20) {\n      setStep(\'error\');\n      return;\n    }\n\n    setStep(\'processing\');\n    setProcessingStage(0);\n\n    // Progressive loading state simulation\n    const timer1 = setTimeout(() => setProcessingStage(1), 500);\n    const timer2 = setTimeout(() => setProcessingStage(2), 1000);\n    const timer3 = setTimeout(() => setProcessingStage(3), 1500);\n    const timer4 = setTimeout(() => {\n      // Parse details from text\n      const lower = noticeText.toLowerCase();\n\n      let company = \'Extracted Enterprise\';\n      let role = \'Software Engineer\';\n      let ctc = \'\342\202\27116 LPA\';\n      let deadline = \'Closes in 4 days\';\n      let deadlineDays = 4;\n      let minCgpa = 7.0;\n      let allowedBranches = [\'CSE\', \'IT\', \'ECE\'];\n      let skills = [\'Data Structures\', \'Python\', \'Algorithms\', \'SQL\'];\n      let rounds = [\n        \'Online Assessment (Coding + Aptitude)\',\n        \'Technical Interview 1 (Data Structures)\',\n        \'Technical Interview 2 (System Design / Projects)\',\n        \'HR / Managerial Round\',\n      ];\n\n      if (lower.includes(\'microsoft\')) {\n        company = \'Microsoft India\';\n        role = \'Software Engineering Intern\';\n        ctc = \'\342\202\2711,25,000 / month\';\n        deadline = \'Closes in 3 days\';\n        deadlineDays = 3;\n        minCgpa = 7.5;\n        allowedBranches = [\'CSE\', \'IT\', \'ECE\'];\n        skills = [\'Python\', \'DSA\', \'SQL\', \'HackerEarth\'];\n        rounds = [\'Online Assessment\', \'Tech 1 (DSA)\', \'Tech 2 (Design)\', \'AA Round\'];\n      } else if (lower.includes(\'razorpay\')) {\n        company = \'Razorpay\';\n        role = \'Graduate Software Engineer\';\n        ctc = \'\342\202\27118.5 LPA\';\n        deadline = \'Closes tomorrow\';\n        deadlineDays = 1;\n        minCgpa = 7.0;\n        allowedBranches = [\'CSE\', \'IT\', \'ECE\', \'EE\'];\n        skills = [\'Python\', \'SQL\', \'FastAPI\', \'Problem Solving\'];\n        rounds = [\'OA (Coding)\', \'Tech 1 (Java/Python)\', \'Tech 2 (LLD)\', \'Bar Raiser\'];\n      } else if (lower.includes(\'google\')) {\n        company = \'Google India\';\n        role = \'Software Engineer \342\200\224 Early Career\';\n        ctc = \'\342\202\27134 LPA\';\n        deadline = \'Closes tonight\';\n        deadlineDays = 1;\n        minCgpa = 8.5;\n        allowedBranches = [\'CSE\', \'IT\'];\n        skills = [\'Advanced DSA\', \'C++\', \'System Design\', \'Algorithms\'];\n        rounds = [\'Online Challenge\', \'Tech Screen 1\', \'Tech Screen 2\', \'Hiring Committee\'];\n      } else {\n        // Fallback intelligent extraction\n        const lines = noticeText.split(\'\\n\').filter((l) => l.trim().length > 0);\n        if (lines[0]) {\n          const firstLine = lines[0].replace(/urgent|notice|circular|tpo|campus/gi, \'\').trim();\n          if (firstLine) company = firstLine.slice(0, 30);\n        }\n      }\n\n      // Check student eligibility\n      const isCgpaMet = student.cgpa >= minCgpa;\n      const isBranchMet = allowedBranches.some((b) => student.branch.includes(b));\n      const hasBacklogs = student.activeBacklogs > 0;\n\n      let status: \'eligible\' | \'borderline\' | \'not_eligible\' = \'eligible\';\n      const reasons: string[] = [];\n\n      if (!isCgpaMet) {\n        status = \'not_eligible\';\n        reasons.push(`Minimum CGPA: ${minCgpa} \302\267 Your CGPA: ${student.cgpa}`);\n      } else if (student.cgpa - minCgpa < 0.3) {\n        status = \'borderline\';\n        reasons.push(`Close to cutoff (${student.cgpa} vs min ${minCgpa}).`);\n      } else {\n        reasons.push(`CGPA (${student.cgpa}) comfortably clears ${minCgpa} cutoff.`);\n      }\n\n      if (!isBranchMet) {\n        status = \'not_eligible\';\n        reasons.push(`Allowed branches: ${allowedBranches.join(\', \')} \302\267 Your branch: ${student.branch}`);\n      }\n\n      if (hasBacklogs) {\n        status = \'not_eligible\';\n        reasons.push(\'Active backlogs not allowed for this drive.\');\n      }\n\n      // Calculate match score\n      let score = 85;\n      if (status === \'eligible\') score = Math.min(96, 85 + Math.round((student.cgpa - minCgpa) * 10));\n      else if (status === \'borderline\') score = 78;\n      else score = Math.max(52, 70 - Math.round((minCgpa - student.cgpa) * 15));\n\n      const eligibilityDetail: EligibilityDetail = {\n        status,\n        reasons,\n        minCgpa,\n        userCgpa: student.cgpa,\n        allowedBranches,\n        userBranch: student.branch,\n        backlogsAllowed: false,\n        hasActiveBacklogs: hasBacklogs,\n      };\n\n      const newOpportunity: Opportunity = {\n        id: `custom-opp-${Date.now()}`,\n        company,\n        role,\n        type: role.toLowerCase().includes(\'intern\') ? \'Internship\' : \'Full-time\',\n        ctc,\n        location: \'Bengaluru / Hyderabad\',\n        deadline,\n        deadlineDays,\n        matchScore: score,\n        eligibility: eligibilityDetail,\n        skills,\n        rounds,\n        description: `Imported directly from placement notice. Eligibility and round details automatically verified against student profile.`,\n        noticeRawText: noticeText,\n        applied: false,\n        source: \'Parsed Circular\',\n      };\n\n      setParsedPreview(newOpportunity);\n      setStep(\'preview\');\n    }, 2000);\n\n    return () => {\n      clearTimeout(timer1);\n      clearTimeout(timer2);\n      clearTimeout(timer3);\n      clearTimeout(timer4);\n    };\n  };\n\n  const handleSave = () => {\n    if (parsedPreview) {\n      onSaveOpportunity(parsedPreview);\n      onClose();\n      // Reset\n      setStep(\'input\');\n      setNoticeText(\'\');\n      setParsedPreview(null);\n    }\n  };\n\n  const handleApplySample = (idx: number) => {\n    setNoticeText(sampleNotices[idx].text);\n    setCopiedSampleIdx(idx);\n    setTimeout(() => setCopiedSampleIdx(null), 1500);\n  };\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#09090D]/60 backdrop-blur-xs animate-in fade-in\"\n      onClick={onClose}\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"inbox-title\"\n    >\n      <div\n        onClick={(e) => e.stopPropagation()}\n        className=\"w-full max-w-2xl bg-[#fcf8ff] rounded-2xl border border-[#c8c0f7] shadow-2xl overflow-hidden max-h-[92vh] flex flex-col animate-in zoom-in-95 duration-150\"\n      >\n        {/* Top Header */}\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-[#e5e0f4] bg-[#f1ebff]\">\n          <div>\n            <h2 id=\"inbox-title\" className=\"text-base sm:text-lg font-black text-[#09090D]\">\n              Placement Notice Extractor\n            </h2>\n            <p className=\"text-xs text-[#5f5888]\">\n              Paste notice \342\206\222 Auto-extract details \342\206\222 Check eligibility \342\206\222 Save\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1 text-[#47464b] hover:text-[#09090D] hover:bg-[#ebe5fa] rounded-lg transition-colors\"\n            aria-label=\"Close dialog\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-6 overflow-y-auto\">\n          {/* STEP 1: INPUT AREA */}\n          {step === \'input\' && (\n            <div className=\"space-y-4\">\n              {/* Journey banner */}\n              <div className=\"bg-[#e5deff] p-3 rounded-xl border border-[#c8c0f7] flex items-center justify-between text-xs text-[#170065] font-semibold\">\n                <span>1. Paste Circular</span>\n                <span className=\"text-[#8174e5]\">\342\206\222</span>\n                <span>2. AI Extraction</span>\n                <span className=\"text-[#8174e5]\">\342\206\222</span>\n                <span>3. Verify Eligibility</span>\n                <span className=\"text-[#8174e5]\">\342\206\222</span>\n                <span>4. Save</span>\n              </div>\n\n              {/* Sample Notices quick buttons */}\n              <div>\n                <span className=\"text-xs font-semibold text-[#5f5888] block mb-2\">\n                  Or load a sample placement circular:\n                </span>\n                <div className=\"flex flex-wrap gap-2\">\n                  {sampleNotices.map((sample, idx) => (\n                    <button\n                      key={idx}\n                      type=\"button\"\n                      onClick={() => handleApplySample(idx)}\n                      className=\"px-2.5 py-1 text-xs font-medium bg-white hover:bg-[#f1ebff] border border-[#c8c5cb] hover:border-[#6257A5] rounded-md transition-colors text-[#1c1a28] inline-flex items-center gap-1.5\"\n                    >\n                      {copiedSampleIdx === idx ? (\n                        <Check className=\"w-3 h-3 text-[#10b981]\" />\n                      ) : (\n                        <Copy className=\"w-3 h-3 text-[#78767b]\" />\n                      )}\n                      <span>{sample.title}</span>\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Large comfortable input */}\n              <div>\n                <label\n                  htmlFor=\"notice-input\"\n                  className=\"block text-xs font-bold text-[#09090D] uppercase tracking-wider mb-1\"\n                >\n                  Raw Placement Circular / WhatsApp Notice\n                </label>\n                <textarea\n                  id=\"notice-input\"\n                  value={noticeText}\n                  onChange={(e) => setNoticeText(e.target.value)}\n                  placeholder=\"Paste notice here... e.g.\nCompany: Microsoft India\nRole: Software Engineering Intern\nEligible: CSE, IT with CGPA >= 7.5\nStipend: \342\202\2711,25,000 / month\nDeadline: 12th Oct 2026\"\n                  rows={8}\n                  className=\"w-full p-3.5 text-xs font-mono-code bg-white border border-[#c8c5cb] focus:border-[#09090D] focus:ring-1 focus:ring-[#09090D] rounded-xl outline-none transition-all placeholder:text-[#78767b] leading-relaxed\"\n                />\n                <span className=\"text-[11px] text-[#78767b] mt-1 block\">\n                  Copy and paste the exact text received on WhatsApp, Telegram, or College TPO emails.\n                </span>\n              </div>\n\n              {/* Action Button */}\n              <div className=\"pt-2 flex justify-end\">\n                <button\n                  type=\"button\"\n                  onClick={handleProcessNotice}\n                  disabled={!noticeText.trim()}\n                  className=\"px-6 py-2.5 bg-[#09090D] hover:bg-[#1b1b1f] disabled:bg-[#c8c5cb] text-[#E3E0F2] font-bold text-xs rounded-xl nexora-btn-press shadow-md transition-all inline-flex items-center gap-2\"\n                >\n                  <Sparkles className=\"w-4 h-4 text-[#7568D8]\" />\n                  <span>Extract & Check Eligibility</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* STEP 2: LOADING / PROCESSING STATE */}\n          {step === \'processing\' && (\n            <div className=\"py-12 px-4 text-center space-y-6\">\n              <div className=\"w-16 h-16 rounded-full bg-[#f1ebff] border-2 border-[#7568D8] border-t-transparent animate-spin mx-auto\" />\n              <div className=\"space-y-2\">\n                <h3 className=\"text-lg font-bold text-[#09090D]\">\n                  {processingSteps[processingStage]}\n                </h3>\n                <p className=\"text-xs text-[#5f5888]\">\n                  Comparing notice cutoffs against your profile ({student.cgpa} CGPA, {student.branch})\n                </p>\n              </div>\n\n              {/* Step progression indicators */}\n              <div className=\"max-w-xs mx-auto space-y-2 text-left text-xs\">\n                {processingSteps.map((s, idx) => (\n                  <div\n                    key={s}\n                    className={`flex items-center gap-2 transition-colors ${\n                      idx <= processingStage ? \'text-[#09090D] font-bold\' : \'text-[#c8c5cb]\'\n                    }`}\n                  >\n                    <span className=\"w-4 h-4 rounded-full flex items-center justify-center text-[10px] border border-current\">\n                      {idx <= processingStage ? \'\342\234\223\' : idx + 1}\n                    </span>\n                    <span>{s}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* STEP 3: CLEAN PREVIEW BEFORE SAVING */}\n          {step === \'preview\' && parsedPreview && (\n            <div className=\"space-y-5 animate-in fade-in\">\n              <div className=\"flex items-center justify-between p-3 bg-[#e5deff] border border-[#c8c0f7] rounded-xl text-xs text-[#170065] font-semibold\">\n                <span className=\"flex items-center gap-1.5\">\n                  <CheckCircle2 className=\"w-4 h-4 text-[#10b981]\" />\n                  Notice Parsed Successfully\n                </span>\n                <span>Review details before saving</span>\n              </div>\n\n              {/* Card Preview */}\n              <div className=\"bg-[#f1ebff] border border-[#d1c8ff] rounded-2xl p-5 space-y-4\">\n                <div className=\"flex items-start justify-between gap-4\">\n                  <div>\n                    <span className=\"text-xs font-bold uppercase tracking-wider text-[#5f5888]\">\n                      {parsedPreview.company}\n                    </span>\n                    <h3 className=\"text-xl font-black text-[#09090D] mt-0.5\">\n                      {parsedPreview.role}\n                    </h3>\n                    <div className=\"flex items-center gap-2 text-xs font-mono-code text-[#47464b] mt-1\">\n                      <span className=\"font-bold text-[#170065]\">{parsedPreview.ctc}</span>\n                      <span>\302\267</span>\n                      <span>{parsedPreview.deadline}</span>\n                    </div>\n                  </div>\n\n                  <div className=\"bg-white p-1.5 rounded-full border border-[#d1c8ff]\">\n                    <MatchRing score={parsedPreview.matchScore} size=\"md\" />\n                  </div>\n                </div>\n\n                {/* Eligibility Result */}\n                <div className=\"pt-3 border-t border-[#d1c8ff]/60\">\n                  <span className=\"text-[11px] font-bold text-[#5f5888] uppercase tracking-wider block mb-1\">\n                    Eligibility Status\n                  </span>\n                  <EligibilityBadge eligibility={parsedPreview.eligibility} showDetails={true} />\n                </div>\n\n                {/* Rounds */}\n                <div className=\"pt-3 border-t border-[#d1c8ff]/60\">\n                  <span className=\"text-[11px] font-bold text-[#5f5888] uppercase tracking-wider block mb-2\">\n                    Extracted Rounds ({parsedPreview.rounds.length})\n                  </span>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs\">\n                    {parsedPreview.rounds.map((round, idx) => (\n                      <div\n                        key={idx}\n                        className=\"bg-white p-2 rounded-lg border border-[#e5e0f4] flex items-center gap-2\"\n                      >\n                        <span className=\"font-mono-code text-[11px] font-bold text-[#5f5888]\">\n                          {idx + 1}.\n                        </span>\n                        <span className=\"truncate\">{round}</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              </div>\n\n              {/* Action buttons */}\n              <div className=\"pt-2 flex items-center justify-between gap-3\">\n                <button\n                  type=\"button\"\n                  onClick={() => setStep(\'input\')}\n                  className=\"px-4 py-2 text-xs font-semibold text-[#47464b] hover:text-[#09090D] bg-white border border-[#c8c5cb] rounded-lg\"\n                >\n                  Edit notice text\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={handleSave}\n                  className=\"px-6 py-2.5 bg-[#09090D] hover:bg-[#1b1b1f] text-[#E3E0F2] font-bold text-xs rounded-lg nexora-btn-press shadow-md transition-colors inline-flex items-center gap-2\"\n                >\n                  <CheckCircle2 className=\"w-4 h-4 text-[#7568D8]\" />\n                  <span>Save opportunity</span>\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* STEP 4: ERROR STATE */}\n          {step === \'error\' && (\n            <div className=\"py-8 px-4 text-center space-y-4\">\n              <div className=\"w-12 h-12 rounded-full bg-[#ffdad6] text-[#ba1a1a] mx-auto flex items-center justify-center\">\n                <AlertTriangle className=\"w-6 h-6\" />\n              </div>\n              <div>\n                <h3 className=\"text-base font-bold text-[#09090D]\">\n                  We couldn\'t read that notice.\n                </h3>\n                <p className=\"text-xs text-[#47464b] mt-1 max-w-sm mx-auto leading-relaxed\">\n                  Try pasting the original placement message again, or use one of our sample notices above.\n                </p>\n              </div>\n\n              <div className=\"pt-2 flex justify-center\">\n                <button\n                  type=\"button\"\n                  onClick={() => setStep(\'input\')}\n                  className=\"px-5 py-2 text-xs font-bold bg-[#09090D] text-[#E3E0F2] rounded-lg inline-flex items-center gap-1.5 nexora-btn-press\"\n                >\n                  <RefreshCw className=\"w-3.5 h-3.5\" />\n                  <span>Try again</span>\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
