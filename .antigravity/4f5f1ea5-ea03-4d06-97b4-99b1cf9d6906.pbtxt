      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-sans: \'DM Sans\', system-ui, -apple-system, sans-serif;\n    --font-serif: \'DM Serif Display\', Georgia, serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n  }\n\n  body {\n    font-family: var(--font-sans);\n    background-color: #fcf8ff;\n    color: #1c1a28;\n    overflow-x: hidden;\n  }\n}\n\n.font-serif-display {\n  font-family: \'DM Serif Display\', Georgia, serif;\n}\n\n.font-mono-code {\n  font-family: \'JetBrains Mono\', monospace;\n}\n\n/* Custom subtle cursor glow */\n.cursor-glow-dot {\n  pointer-events: none;\n  position: fixed;\n  width: 420px;\n  height: 420px;\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(169, 161, 214, 0.22) 0%, rgba(199, 191, 234, 0.08) 45%, transparent 70%);\n  transform: translate(-50%, -50%);\n  transition: transform 0.12s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;\n  z-index: 1;\n}\n\n/* Card hover lift & press feedback */\n.nexora-card-lift {\n  transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.18s ease;\n}\n\n.nexora-card-lift:hover {\n  transform: translateY(-2px);\n}\n\n.nexora-btn-press {\n  transition: transform 0.12s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.12s ease;\n}\n\n.nexora-btn-press:active {\n  transform: scale(0.98);\n}\n"
