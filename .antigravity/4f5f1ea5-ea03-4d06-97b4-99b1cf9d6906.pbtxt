          text: "      ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      correctAnswer: \'B\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      explanation: \'Unreleased connections lead to pool starvation; pending requests queue indefinitely until pool timeout threshold is breached.\',"
