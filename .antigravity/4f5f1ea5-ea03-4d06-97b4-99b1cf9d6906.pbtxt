ers: \'Seattle, WA \302\267 India: Hyderabad / Bengaluru\',\\n    tier: \'Tier-1 Day 0\',\\n    overview: \'Global e-commerce marketplace, AWS cloud computing services, and fulfillment technology.\',\\n    roles: [\\n      {\\n        id: \'opp-amazon-sde1\',\\n        company: \'Amazon\',\\n        role: \'Software Development Engineer 1\',\\n        type: \'Full-time\',\\n        ctc: \'\342\202\27132 LPA (\342\202\27116.5L Base + Sign-on + Stocks)\',\\n        location: \'Bengaluru / Hyderabad\',\\n        deadline: \'Closes in 5 days\',\\n        deadlineDays: 5,\\n        matchScore: 87,\\n        eligibility: {\\n          status: \'eligible\',\\n          reasons: [\'Minimum CGPA is 7.0 (Your CGPA: 7.8).\', \'CSE branch approved.\', \'0 backlogs required.\'],\\n          minCgpa: 7.0,\\n          userCgpa: 7.8,\\n          allowedBranches: [\'CSE\', \'IT\', \'ECE\'],\\n          userBranch: \'CSE\',\\n          backlogsAllowed: false,\\n          hasActiveBacklogs: false,\\n        },\\n        skills: [\'Data Structures\', \'Java / Python\', \'OOP Design\', \'Leadership Principles\'],\\n        rounds: [\'Online Assessment (Debugging + 2 Coding + Work Style Simulation)\', \'Tech 1 (DSA)\', \'Tech 2 (DSA & LLD)\', \'Bar Raiser (STAR Method)\'],\\n        description: \'Build backend distribution algorithms and catalog ranking engines serving hundreds of millions of consumers.\',\\n        source: \'Campus Portal\',\\n      },\\n      {\\n        id: \'opp-amazon-intern\',\\n        company: \'Amazon\',\\n        role: \'SDE 6-Month Intern\',\\n        type: \'6M Internship + PPO\',\\n        ctc: \'\342\202\27180,000 / month\',\\n        location: \'Hyderabad\',\\n        deadline: \'Closes in 4 days\',\\n        deadlineDays: 4,\\n        matchScore: 88,\\n        eligibility: {\\n          status: \'eligible\',\\n          reasons: [\'Your CGPA (7.8) clears the 7.0 cutoff.\', \'CSE discipline approved.\'],\\n          minCgpa: 7.0,\\n          userCgpa: 7.8,\\n          allowedBranches: [\'CSE\', \'IT\', \'ECE\'],\\n          userBranch: \'CSE\',\\n          backlogsAllowed: false,\\n          hasActiveBacklogs: false,\\n        },\\n        skills: [\'DSA\', \'Problem Solving\', \'Operating Systems\', \'Databases\'],\\n        rounds: [\'HackerRank Test (2 Questions)\', \'Tech Interview 1\', \'Tech Interview 2\'],\\n        description: \'6-month full-time internship with high direct PPO conversion based on sprint delivery.\',\\n        source: \'Campus Portal\',\\n      },\\n    ],\\n  },\\n  {\\n    id: \'comp-morganstanley\',\\n    name: \'Morgan Stanley\',\\n    category: \'Global Investment Banking\',\\n    headquarters: \'New York, NY \302\267 India: Mumbai / Bengaluru\',\\n    tier: \'Tier-1 Day 1\',\\n    overview: \'Global investment banking, securities trading infrastructure, and quantitative risk modeling.\',\\n    roles: [\\n      initialOpportunities[5], // Technology Analyst\\n      {\\n        id: \'opp-ms-fulltime\',\\n        company: \'Morgan Stanley\',\\n        role: \'Technology Analyst \342\200\224 Core Java\',\\n        type: \'Full-time\',\\n        ctc: \'\342\202\27124 LPA\',\\n        location: \'Mumbai / Bengaluru\',\\n        deadline: \'Closes in 10 days\',\\n        deadlineDays: 10,\\n        matchScore: 83,\\n        eligibility: {\\n          status: \'eligible\',\\n          reasons: [\'Minimum CGPA is 7.5 (Your CGPA: 7.8).\', \'CSE branch approved for this specific FTE role.\', \'0 backlogs.\'],\\n          minCgpa: 7.5,\\n          userCgpa: 7.8,\\n          allowedBranches: [\'CSE\', \'IT\'],\\n          userBranch: \'CSE\',\\n          backlogsAllowed: false,\\n          hasActiveBacklogs: false,\\n        },\\n        skills: [\'Java / Python\', \'Multithreading\', \'SQL\', \'Algorithms\'],\\n        rounds: [\'Online Assessment (Quant + Logic + Coding)\', \'Technical Round 1\', \'Technical Round 2\', \'Professional Fit\'],\\n        description: \'Engineer high-frequency transaction settlement and risk aggregation pipelines for institutional clients.\',\\n        source: \'Campus Portal\',\\n      },\\n    ],\\n  },\\n];\\n\\nexport const sampleGapsForRole: Record<string, ResumeGap[]> = {\\n  default: [\\n    {\\n      id: \'gap-1\',\\n      area: \'Vague Impact Metrics\',\\n      severity: \'high\',\\n      description: \'Your e-commerce project bullet states \\\"built backend APIs with FastAPI\\\" but provides zero quantitative latency or user throughput metrics.\',\\n      recommendation: \'Replace with: \\\"Engineered 12 REST endpoints with FastAPI and PostgreSQL, serving 1,200 simulated req/sec with <45ms p95 latency.\\\"\',\\n    },\\n    {\\n      id: \'gap-2\',\\n      area: \'Missing Concurrency / Async Depth\',\\n      severity: \'high\',\\n      description: \'Role explicitly highlights multithreading or asynchronous task management. Your resume lists Python and React without demonstrating async workers or queueing.\',\\n      recommendation: \'Highlight your Celery or Redis background worker implementation in your final semester capstone project.\',\\n    },\\n    {\\n      id: \'gap-3\',\\n      area: \'Absence of Automated Testing\',\\n      severity: \'medium\',\\n      description: \'The job posting checks for unit/integration testing craftsmanship. No test framework (pytest, Jest) is listed across any of your 3 projects.\',\\n      recommendation: \'Add a bullet acknowledging unit test coverage (e.g. \\\"Maintained 84% test coverage using pytest fixtures and GitHub Actions\\\").\',\\n    },\\n  ],\\n};\\n\\n// Tailored 4-Option MCQs based on candidate profile (Python, FastAPI, React, SQL, DSA) & target company requirements\\nexport const sampleMcqsByCompany: Record<string, InterviewMCQ[]> = {\\n  Microsoft: [\\n    {\\n      id: \'ms-mcq-1\',\\n      topic: \'Database Connection Pooling\',\\n      category: \'Technical\',\\n      whyRelevantToJob: \'Targeting Microsoft Azure Cloud SWE. Matches your FastAPI & PostgreSQL resume project.\',\\n      question: \'In a high-concurrency FastAPI service querying PostgreSQL, what occurs if endpoints do not release connections back to the connection pool upon unexpected exceptions?\',\\n      options: [\\n        { key: \'A\', text: \'PostgreSQL automatically terminates idle transactions after 50 milliseconds.\' },\\n        { key: \'B\', text: \'Pool connections exhaust rapidly, causing subsequent concurrent client requests to hang and time out with HTTP 504 errors.\' },\\n        { key: \'C\', text: \'FastAPI dynamically spawns extra CPU threads to duplicate the database connection pool.\' },\\n        { key: \'D\', text: \'PostgreSQL switches automatically into in-memory read-only replica mode.\' },\\n      ],\\n      correctAnswer: \'B\',\\n      explanation: \'Unreleased connections lead to pool starvation; pending requests queue indefinitely until pool timeout threshold is breached.\',\\n    },\\n    {\\n      id: \'ms-mcq-2\',\\n      topic: \'Sliding Window Algorithm Complexity\',\\n      category: \'DSA / System\',\\n      whyRelevantToJob: \'Frequently asked in Microsoft Online Assessments (HackerEarth) and Round 1 DSA.\',\\n      question: \'When implementing a rate limiter using the sliding window log algorithm with Redis sorted sets (ZADD and ZREMRANGEBYSCORE), what is the primary memory drawback at high request volumes?\',\\n      options: [\\n        { key: \'A\', text: \'Redis logs every request timestamp as an individual sorted set element, creating heavy memory overhead compared to Token Bucket.\' },\\n        { key: \'B\', text: \'Redis cannot execute Lua scripts atomically inside sorted sets.\' },\\n        { key: \'C\', text: \'Sliding window logs only work with string data types and reject timestamps.\' },\\n        { key: \'D\', text: \'The time complexity of ZREMRANGEBYSCORE is O(N^2) where N is the total keys in Redis.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'Every transaction writes a timestamp element; high request spikes inflate Redis memory consumption significantly compared to fixed counters.\',\\n    },\\n    {\\n      id: \'ms-mcq-3\',\\n      topic: \'Python Asyncio & GIL Internals\',\\n      category: \'Core CS\',\\n      whyRelevantToJob: \'Your resume features Python & FastAPI as core strengths for cloud backend systems.\',\\n      question: \'Why does running a CPU-bound mathematical loop inside a Python async def endpoint degrade latency across other concurrent async endpoints in the same worker process?\',\\n      options: [\\n        { key: \'A\', text: \'Asyncio generates an OS segfault when encountering integer arithmetic.\' },\\n        { key: \'B\', text: \'The CPU-bound code blocks Python single-threaded event loop, preventing other scheduled coroutines from executing until the loop yields.\' },\\n        { key: \'C\', text: \'Python Global Interpreter Lock (GIL) is disabled whenever async keyword is invoked.\' },\\n        { key: \'D\', text: \'FastAPI converts all async endpoints into synchronous subprocesses.\' },\\n      ],\\n      correctAnswer: \'B\',\\n      explanation: \'Python asyncio is cooperative single-threaded concurrency; a CPU-intensive loop never yields control back to the event loop.\',\\n    },\\n    {\\n      id: \'ms-mcq-4\',\\n      topic: \'SQL Indexing B-Trees\',\\n      category: \'Technical\',\\n      whyRelevantToJob: \'Tested in Microsoft Round 2 System & Data Architecture.\',\\n      question: \'Given a composite index ON users(last_name, first_name), which of the following SQL WHERE clauses CANNOT utilize this composite index efficiently?\',\\n      options: [\\n        { key: \'A\', text: \'WHERE last_name = \\\\\'Sharma\\\\\' AND first_name = \\\\\'Aman\\\\\'\' },\\n        { key: \'B\', text: \'WHERE last_name = \\\\\'Sharma\\\\\'\' },\\n        { key: \'C\', text: \'WHERE first_name = \\\\\'Aman\\\\\'\' },\\n        { key: \'D\', text: \'WHERE last_name LIKE \\\\\'Sha%\\\\\'\' },\\n      ],\\n      correctAnswer: \'C\',\\n      explanation: \'B-tree composite indexes must satisfy the leftmost prefix rule; filtering on `first_name` alone skips the leading index key and triggers a full table scan.\',\\n    },\\n    {\\n      id: \'ms-mcq-5\',\\n      topic: \'System Reliability & Idempotency\',\\n      category: \'Project Defense\',\\n      whyRelevantToJob: \'Your resume highlights payment handling and REST API design.\',\\n      question: \'How should a distributed client implement idempotency when submitting a payment API request to guarantee it is only processed once despite network retries?\',\\n      options: [\\n        { key: \'A\', text: \'Attach a unique client-generated UUID (Idempotency Key) in headers and verify on server using an atomic cache lock before processing.\' },\\n        { key: \'B\', text: \'Instruct the user never to tap submit twice on the browser.\' },\\n        { key: \'C\', text: \'Rely solely on TCP network packet checksums.\' },\\n        { key: \'D\', text: \'Convert all HTTP POST requests into HTTP GET queries.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'A client-generated idempotency key stored in Redis/DB with atomic conditional lock guarantees duplicate network retries return the cached original result.\',\\n    },\\n  ],\\n  Razorpay: [\\n    {\\n      id: \'rzp-mcq-1\',\\n      topic: \'Payment Idempotency & Concurrency\',\\n      category: \'Technical\',\\n      whyRelevantToJob: \'Targeting Razorpay Graduate Software Engineer role (Financial Switchrails).\',\\n      question: \'When two concurrent webhook callbacks for the same payment transaction arrive simultaneously at Razorpay switch, how is a race condition prevented in the database?\',\\n      options: [\\n        { key: \'A\', text: \'By executing `SELECT ... FOR UPDATE` (row-level pessimistic locking) or database unique constraint on transaction_id.\' },\\n        { key: \'B\', text: \'By dropping the database table and re-creating it dynamically.\' },\\n        { key: \'C\', text: \'By sleeping for 2 seconds before writing each transaction.\' },\\n        { key: \'D\', text: \'By letting both write and trusting the client to deduct refunds.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'Row-level locking (`SELECT FOR UPDATE`) or a strict unique constraint on transaction_id serializes concurrent writes and preserves ACID guarantees.\',\\n    },\\n    {\\n      id: \'rzp-mcq-2\',\\n      topic: \'Database Isolation Levels\',\\n      category: \'Core CS\',\\n      whyRelevantToJob: \'Core CS requirement in Razorpay Technical Round 1.\',\\n      question: \'Which ANSI SQL transaction isolation level prevents Dirty Reads and Non-Repeatable Reads, but may still permit Phantom Reads in standard databases?\',\\n      options: [\\n        { key: \'A\', text: \'Read Uncommitted\' },\\n        { key: \'B\', text: \'Read Committed\' },\\n        { key: \'C\', text: \'Repeatable Read\' },\\n        { key: \'D\', text: \'Serializable\' },\\n      ],\\n      correctAnswer: \'C\',\\n      explanation: \'Repeatable Read locks existing rows read by the transaction (preventing non-repeatable reads), but newly inserted rows can still appear as phantoms.\',\\n    },\\n    {\\n      id: \'rzp-mcq-3\',\\n      topic: \'API Rate Limiting with Redis\',\\n      category: \'DSA / System\',\\n      whyRelevantToJob: \'Directly maps to the merchant gateway rate-limiter project on your resume.\',\\n      question: \'Why are Redis Lua scripts considered the gold standard for implementing token bucket rate limiting on high-throughput payment APIs?\',\\n      options: [\\n        { key: \'A\', text: \'Lua scripts run atomically on the Redis single-threaded engine, preventing race conditions between checking and decrementing tokens.\' },\\n        { key: \'B\', text: \'Lua executes faster than C++ binary code.\' },\\n        { key: \'C\', text: \'Lua scripts bypass all Redis network authentication.\' },\\n        { key: \'D\', text: \'Lua scripts automatically backup Redis data to AWS S3.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'Redis executes Lua scripts atomically in a single step, eliminating race conditions between inspecting available tokens and deducting them.\',\\n    },\\n    {\\n      id: \'rzp-mcq-4\',\\n      topic: \'HTTP 429 vs HTTP 503\',\\n      category: \'Technical\',\\n      whyRelevantToJob: \'API status code standards checked in Razorpay LLD round.\',\\n      question: \'When a merchant exceeds their allocated payment API quota of 500 requests per minute, which HTTP status code and header must the API return?\',\\n      options: [\\n        { key: \'A\', text: \'HTTP 500 Internal Server Error with no headers.\' },\\n        { key: \'B\', text: \'HTTP 429 Too Many Requests, accompanied by a `Retry-After` header.\' },\\n        { key: \'C\', text: \'HTTP 401 Unauthorized with login redirect.\' },\\n        { key: \'D\', text: \'HTTP 200 OK with error body.\' },\\n      ],\\n      correctAnswer: \'B\',\\n      explanation: \'RFC 6585 specifies HTTP 429 Too Many Requests with a `Retry-After` header indicating seconds the client should pause before retrying.\',\\n    },\\n    {\\n      id: \'rzp-mcq-5\',\\n      topic: \'DSA - Top K Frequent Elements\',\\n      category: \'DSA / System\',\\n      whyRelevantToJob: \'Standard question in Razorpay Online Assessment and Problem Solving round.\',\\n      question: \'What is the optimal time complexity to find the top K most frequent merchant error codes from an array of N elements?\',\\n      options: [\\n        { key: \'A\', text: \'O(N^2) using nested linear scans.\' },\\n        { key: \'B\', text: \'O(N log K) using a hash map and a min-heap of size K, or O(N) using Bucket Sort.\' },\\n        { key: \'C\', text: \'O(K log N) with bubble sort.\' },\\n        { key: \'D\', text: \'O(1) with random indexing.\' },\\n      ],\\n      correctAnswer: \'B\',\\n      explanation: \'Frequency hashing takes O(N), followed by either a min-heap of size K taking O(N log K) or bucket sort by frequency taking O(N) time.\',\\n    },\\n  ],\\n  Google: [\\n    {\\n      id: \'goog-mcq-1\',\\n      topic: \'Algorithm Invariants & Binary Search\',\\n      category: \'DSA / System\',\\n      whyRelevantToJob: \'Google early-career screening test focus.\',\\n      question: \'In a rotated sorted array with distinct integers, how do you determine in O(log N) time which half of the array is sorted at any step `mid`?\',\\n      options: [\\n        { key: \'A\', text: \'Compare nums[mid] with nums[left]: if nums[left] <= nums[mid], the left half is guaranteed monotonically sorted.\' },\\n        { key: \'B\', text: \'Sort the entire array using QuickSort first.\' },\\n        { key: \'C\', text: \'Check if mid is an even or odd index.\' },\\n        { key: \'D\', text: \'Rotate the array 360 degrees in memory.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'Comparing mid with left tells you whether the left half has no pivot discontinuity, guaranteeing it is strictly sorted.\',\\n    },\\n    {\\n      id: \'goog-mcq-2\',\\n      topic: \'Virtual Memory & Page Faults\',\\n      category: \'Core CS\',\\n      whyRelevantToJob: \'Core OS fundamentals evaluated in Google Technical Screen.\',\\n      question: \'When a process attempts to access a virtual memory address whose page table entry has the valid/present bit set to 0, what hardware mechanism triggers?\',\\n      options: [\\n        { key: \'A\', text: \'The CPU raises a Page Fault interrupt, handing control to the OS kernel to load the page from swap/disk into RAM.\' },\\n        { key: \'B\', text: \'The program terminates with an immediate hardware power cut.\' },\\n        { key: \'C\', text: \'The CPU automatically clears all CPU registers to zero.\' },\\n        { key: \'D\', text: \'The CPU writes random bytes to the address.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'A present bit of 0 triggers a CPU page fault exception trap; the OS fetches the missing memory page into a free frame and updates page tables.\',\\n    },\\n    {\\n      id: \'goog-mcq-3\',\\n      topic: \'Two Pointers vs Dynamic Programming\',\\n      category: \'DSA / System\',\\n      whyRelevantToJob: \'Optimal complexity trade-off analysis in Google Coding round.\',\\n      question: \'Which data structure allows finding the median of a continuous real-time data stream in O(log N) insertion time and O(1) query time?\',\\n      options: [\\n        { key: \'A\', text: \'A single unsorted array.\' },\\n        { key: \'B\', text: \'Two balanced heaps: a Max-Heap for the lower half and a Min-Heap for the upper half.\' },\\n        { key: \'C\', text: \'A singly linked list with tail pointer.\' },\\n        { key: \'D\', text: \'A circular FIFO queue of fixed capacity.\' },\\n      ],\\n      correctAnswer: \'B\',\\n      explanation: \'Balancing the sizes of a max-heap (storing smaller half) and min-heap (storing larger half) keeps the median directly accessible at heap roots.\',\\n    },\\n    {\\n      id: \'goog-mcq-4\',\\n      topic: \'Concurrency & Deadlocks\',\\n      category: \'Core CS\',\\n      whyRelevantToJob: \'Google systems screening interview question.\',\\n      question: \'Which of the following conditions is NOT one of the four Coffman conditions required for a deadlock to exist?\',\\n      options: [\\n        { key: \'A\', text: \'Mutual Exclusion\' },\\n        { key: \'B\', text: \'Hold and Wait\' },\\n        { key: \'C\', text: \'Preemption Allowed\' },\\n        { key: \'D\', text: \'Circular Wait\' },\\n      ],\\n      correctAnswer: \'C\',\\n      explanation: \'The Coffman condition is No Preemption (resources cannot be forcibly reclaimed); if preemption is allowed, deadlocks can be resolved.\',\\n    },\\n  ],\\n  Atlassian: [\\n    {\\n      id: \'atl-mcq-1\',\\n      topic: \'React Reconciliation & Virtual DOM\',\\n      category: \'Technical\',\\n      whyRelevantToJob: \'Targeting Atlassian frontend/full-stack teams (Jira & Confluence web UI).\',\\n      question: \'Why is using array index as a `key` prop in React lists considered harmful during item re-ordering or deletion?\',\\n      options: [\\n        { key: \'A\', text: \'React throws a fatal JavaScript syntax exception.\' },\\n        { key: \'B\', text: \'React reuses DOM nodes based on index, causing component local state and input values to get attached to the wrong item.\' },\\n        { key: \'C\', text: \'Array index disables CSS animations permanently.\' },\\n        { key: \'D\', text: \'Virtual DOM memory footprint quadruples.\' },\\n      ],\\n      correctAnswer: \'B\',\\n      explanation: \'When keys are unstable indexes, React reconciler assumes the position matches and reuses component instances, causing stale state and visual bugs.\',\\n    },\\n    {\\n      id: \'atl-mcq-2\',\\n      topic: \'Optimistic UI Updates\',\\n      category: \'Project Defense\',\\n      whyRelevantToJob: \'Matches collaborative editing features in Jira/Confluence.\',\\n      question: \'How should a web client implement optimistic UI updates when a user drags a Jira task ticket to \\\"Done\\\"?\',\\n      options: [\\n        { key: \'A\', text: \'Block the browser screen with a full-page modal until the HTTP 200 response returns after 2 seconds.\' },\\n        { key: \'B\', text: \'Immediately update local UI state to \\\"Done\\\", fire background API call, and revert to previous state with an error toast if API fails.\' },\\n        { key: \'C\', text: \'Reload the entire webpage window.\' },\\n        { key: \'D\', text: \'Never update the UI until the user clicks refresh.\' },\\n      ],\\n      correctAnswer: \'B\',\\n      explanation: \'Optimistic updates update client state instantly for responsive UX, paired with a rollback handler if server validation fails.\',\\n    },\\n    {\\n      id: \'atl-mcq-3\',\\n      topic: \'Distributed Webhook Retries & Exponential Backoff\',\\n      category: \'DSA / System\',\\n      whyRelevantToJob: \'Atlassian Craftsmanship and System Design round question.\',\\n      question: \'Why should automated webhook retry algorithms include randomized \\\"jitter\\\" in their exponential backoff formula (e.g. 2^n + random)?\',\\n      options: [\\n        { key: \'A\', text: \'To prevent the \\\"Thundering Herd\\\" problem where thousands of failed clients retry simultaneously and overwhelm the recovering server.\' },\\n        { key: \'B\', text: \'To encrypt the HTTP payload in transit.\' },\\n        { key: \'C\', text: \'Because Python `random` module runs faster than math power.\' },\\n        { key: \'D\', text: \'To guarantee delivery within exactly 10 milliseconds.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'Jitter spreads out retry timestamps across a time window, preventing synchronized bursts from hammering an already degraded downstream service.\',\\n    },\\n    {\\n      id: \'atl-mcq-4\',\\n      topic: \'Node.js Event Loop Microtasks\',\\n      category: \'Technical\',\\n      whyRelevantToJob: \'Your resume lists Node.js as a core full-stack technology.\',\\n      question: \'In the Node.js event loop, when do `process.nextTick` and resolved `Promise.then` microtasks execute relative to `setTimeout(..., 0)` macrotasks?\',\\n      options: [\\n        { key: \'A\', text: \'Microtasks execute immediately after the current operation finishes, before the event loop advances to the next macrotask phase.\' },\\n        { key: \'B\', text: \'Microtasks execute only after all setTimeouts across the next 5 seconds finish.\' },\\n        { key: \'C\', text: \'Microtasks run on a separate background thread in parallel.\' },\\n        { key: \'D\', text: \'Microtasks are only supported in browser runtimes, not Node.js.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'The microtask queue (nextTick and Promises) has priority and empties immediately at the end of each tick before the next timer/macrotask is processed.\',\\n    },\\n  ],\\n  PhonePe: [\\n    {\\n      id: \'pp-mcq-1\',\\n      topic: \'High-Throughput UPI Queues\',\\n      category: \'Technical\',\\n      whyRelevantToJob: \'PhonePe handles >10,000 transactions/sec on Kafka clusters.\',\\n      question: \'In Apache Kafka, if you have 8 partitions for a `payments-inbound` topic, what is the maximum number of consumer instances within the same consumer group that can read in parallel?\',\\n      options: [\\n        { key: \'A\', text: \'Unlimited consumers.\' },\\n        { key: \'B\', text: \'8 consumers; any additional 9th consumer instance will remain idle.\' },\\n        { key: \'C\', text: \'Only 1 consumer can ever read from a Kafka topic.\' },\\n        { key: \'D\', text: \'16 consumers (2 per partition).\' },\\n      ],\\n      correctAnswer: \'B\',\\n      explanation: \'A partition in a topic can only be assigned to a single consumer within a consumer group at any given time; extra consumers stay idle.\',\\n    },\\n    {\\n      id: \'pp-mcq-2\',\\n      topic: \'Database Sharding & Hotspots\',\\n      category: \'DSA / System\',\\n      whyRelevantToJob: \'PhonePe Technical Deep Dive round question.\',\\n      question: \'When sharding a user payments table horizontally across 16 database nodes, why is choosing `created_at` timestamp as the shard key a dangerous anti-pattern?\',\\n      options: [\\n        { key: \'A\', text: \'Timestamps are incompatible with B-tree indexes.\' },\\n        { key: \'B\', text: \'All incoming writes for the current minute will hit only the single latest shard, creating a severe write hotspot.\' },\\n        { key: \'C\', text: \'Timestamps cannot be stored in 64-bit integers.\' },\\n        { key: \'D\', text: \'Sharding only works with string UUID keys.\' },\\n      ],\\n      correctAnswer: \'B\',\\n      explanation: \'Monotonically increasing keys like timestamps concentrate 100% of current writes onto one shard node, defeating the purpose of horizontal scaling.\',\\n    },\\n    {\\n      id: \'pp-mcq-3\',\\n      topic: \'Cache Stampede & Mutex Locks\',\\n      category: \'DSA / System\',\\n      whyRelevantToJob: \'Evaluates resilience on high-traffic Redis caches.\',\\n      question: \'When a cached merchant profile key expires during flash peak traffic, hundreds of concurrent requests query the database at once. What pattern mitigates this \\\"cache stampede\\\"?\',\\n      options: [\\n        { key: \'A\', text: \'Distributed mutex lock (single-flight) so only 1 worker queries DB to repopulate cache while others wait, or probabilistic early expiration.\' },\\n        { key: \'B\', text: \'Delete the database to force clients to use browser memory.\' },\\n        { key: \'C\', text: \'Set cache TTL to 0 seconds.\' },\\n        { key: \'D\', text: \'Disable caching completely.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'A distributed lock or single-flight loader ensures only one thread hits the database on cache miss while all other concurrent requests wait for the fresh cache.\',\\n    },\\n  ],\\n};\\n\\n// Fallback generator for any custom or newly parsed company\\nexport function getMcqsForOpportunity(opp: Opportunity, student: StudentProfile): InterviewMCQ[] {\\n  const companyKey = Object.keys(sampleMcqsByCompany).find((k) =>\\n    opp.company.toLowerCase().includes(k.toLowerCase())\\n  );\\n\\n  if (companyKey && sampleMcqsByCompany[companyKey]) {\\n    return sampleMcqsByCompany[companyKey];\\n  }\\n\\n  // Generates 4 rich MCQs based on role, candidate skills & JD\\n  return [\\n    {\\n      id: `${opp.id}-mcq-1`,\\n      topic: \'API Concurrency & Architecture\',\\n      category: \'Technical\',\\n      whyRelevantToJob: `Tailored for ${opp.company} (${opp.role}) based on your ${student.skills.slice(0, 2).join(\' & \')} resume stack.`,\\n      question: `For ${opp.role} at ${opp.company}, how should an asynchronous service handle sudden 10x traffic spikes without dropping database connections?`,\\n      options: [\\n        { key: \'A\', text: \'Configure an asynchronous connection pool with strict max overflow and put an asynchronous message queue (e.g. RabbitMQ/Redis) in front of heavy tasks.\' },\\n        { key: \'B\', text: \'Open a fresh direct TCP connection for every incoming HTTP request.\' },\\n        { key: \'C\', text: \'Increase operating system file limits to infinity.\' },\\n        { key: \'D\', text: \'Disable database transaction logs.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'A bounded connection pool protects the database from connection exhaustion, while background queues absorb request bursts gracefully.\',\\n    },\\n    {\\n      id: `${opp.id}-mcq-2`,\\n      topic: \'Algorithmic Efficiency & DSA\',\\n      category: \'DSA / System\',\\n      whyRelevantToJob: `Tested in ${opp.company}\'s initial technical assessment.`,\\n      question: `What is the most space-efficient way to detect a cycle in a singly linked list in O(N) time?`,\\n      options: [\\n        { key: \'A\', text: \'Floyd\\\\\'s Tortoise and Hare algorithm using two pointers moving at speeds 1 and 2, requiring O(1) auxiliary space.\' },\\n        { key: \'B\', text: \'Store every visited node pointer in a Hash Set requiring O(N) memory.\' },\\n        { key: \'C\', text: \'Reverse the linked list and check if the head remains unchanged.\' },\\n        { key: \'D\', text: \'Convert the linked list into a JSON string.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'Floyd\\\\\'s cycle finding algorithm detects loops in linear time with zero extra heap allocations.\',\\n    },\\n    {\\n      id: `${opp.id}-mcq-3`,\\n      topic: \'SQL Performance & Indexing\',\\n      category: \'Technical\',\\n      whyRelevantToJob: `Matches database requirements in ${opp.company} job description.`,\\n      question: `Why does wrapping an indexed column inside a function in a SQL query (e.g. WHERE UPPER(email) = \'USER@EXAMPLE.COM\') cause slow query performance?`,\\n      options: [\\n        { key: \'A\', text: \'It prevents the database query planner from using the standard B-tree index on \\\\`email\\\\`, forcing a full table scan.\' },\\n        { key: \'B\', text: \'The SQL database parser crashes when handling uppercase functions.\' },\\n        { key: \'C\', text: \'Functions convert SQL strings into binary blobs.\' },\\n        { key: \'D\', text: \'B-tree indexes only store lowercase letters.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'Applying a function to an indexed column invalidates standard index lookups unless an explicit functional/expression index is created.\',\\n    },\\n    {\\n      id: `${opp.id}-mcq-4`,\\n      topic: \'System Design & Failure Isolation\',\\n      category: \'Project Defense\',\\n      whyRelevantToJob: `Interviewers at ${opp.company} assess engineering craftsmanship and edge case resilience.`,\\n      question: `What is the primary role of the Circuit Breaker pattern in microservice architectures?`,\\n      options: [\\n        { key: \'A\', text: \'To immediately fail fast and prevent cascading system-wide outages when a dependent downstream service is unresponsive.\' },\\n        { key: \'B\', text: \'To encrypt network packets between internal microservices.\' },\\n        { key: \'C\', text: \'To balance HTTP traffic across AWS regions.\' },\\n        { key: \'D\', text: \'To automatically increase Docker CPU container limits.\' },\\n      ],\\n      correctAnswer: \'A\',\\n      explanation: \'Circuit breakers trip to open state when failure thresholds are exceeded, returning fallbacks instantly rather than waiting for downstream timeouts.\',\\n    },\\n  ];\\n}\\n\\nexport const initialRejections: RejectionRecord[] = [\\n  {\\n    id: \'rej-1\',\\n    company: \'Swiggy\',\\n    role: \'Software Engineer 1\',\\n    stage: \'Aptitude / Online Test\',\\n    date: \'Sep 28, 2026\',\\n    primaryCause: \'Speed on quantitative aptitude (Probability and Time & Distance questions ran out of time).\',\\n    takeaway: \'Coding score was 100%, but section cutoff for Quant was missed by 2 questions.\',\\n  },\\n  {\\n    id: \'rej-2\',\\n    company: \'Amazon\',\\n    role: \'SDE Intern\',\\n    stage: \'Aptitude / Online Test\',\\n    date: \'Sep 19, 2026\',\\n    primaryCause: \'Timed out during the 20-minute logical reasoning section of the HackerRank assessment.\',\\n    takeaway: \'Aptitude time management is the bottleneck, not programming logic.\',\\n  },\\n  {\\n    id: \'rej-3\',\\n    company: \'CRED\',\\n    role: \'Frontend Engineer Intern\',\\n    stage: \'Technical Round 1\',\\n    date: \'Sep 08, 2026\',\\n    primaryCause: \'Hesitated when explaining React fiber architecture and concurrent mode reconciliation under the hood.\',\\n    takeaway: \'Review core JavaScript event loop and React rendering lifecycle internals.\',\\n  },\\n  {\\n    id: \'rej-4\',\\n    company: \'TCS Digital\',\\n    role: \'Systems Engineer\',\\n    stage: \'Aptitude / Online Test\',\\n    date: \'Aug 24, 2026\',\\n    primaryCause: \'Advanced numerical ability section cutoff not cleared.\',\\n    takeaway: \'Confirms the 3/4 recurring pattern across early-stage online tests.\',\\n  },\\n];\\n\\nexport const initialProgress: ProgressSummary = {\\n  applications: 14,\\n  interviews: 4,\\n  offers: 1,\\n  rejections: 5,\\n  biggestPattern: {\\n    headline: \'YOUR BIGGEST PATTERN\',\\n    description: \'3 of your last 4 rejections happened during aptitude.\',\\n    highlightCount: \'3 of 4 in Online Assessment\',\\n  },\\n  nextFocus: {\\n    title: \'WHAT TO DO NEXT\',\\n    action: \'Practice 20 aptitude questions before your next assessment.\',\\n    suggestedDrill: \'Target Time & Work, Permutations, and Fast Mental Math (15 mins/day).\',\\n  },\\n};\\n\", \"Overwrite\