    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Check, User, GraduationCap, Award, BookOpen } from \'lucide-react\';\nimport { StudentProfile } from \'../types\';\n\ninterface StudentProfileModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  student: StudentProfile;\n  onUpdateStudent: (updated: StudentProfile) => void;\n}\n\nexport const StudentProfileModal: React.FC<StudentProfileModalProps> = ({\n  isOpen,\n  onClose,\n  student,\n  onUpdateStudent,\n}) => {\n  const [formData, setFormData] = useState<StudentProfile>(student);\n  const [skillInput, setSkillInput] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const handleAddSkill = (e: React.KeyboardEvent) => {\n    if (e.key === \'Enter\' && skillInput.trim()) {\n      e.preventDefault();\n      if (!formData.skills.includes(skillInput.trim())) {\n        setFormData({\n          ...formData,\n          skills: [...formData.skills, skillInput.trim()],\n        });\n      }\n      setSkillInput(\'\');\n    }\n  };\n\n  const handleRemoveSkill = (skillToRemove: string) => {\n    setFormData({\n      ...formData,\n      skills: formData.skills.filter((s) => s !== skillToRemove),\n    });\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    onUpdateStudent(formData);\n    onClose();\n  };\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#09090D]/60 backdrop-blur-xs animate-in fade-in\"\n      onClick={onClose}\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"profile-title\"\n    >\n      <div\n        onClick={(e) => e.stopPropagation()}\n        className=\"w-full max-w-lg bg-[#fcf8ff] rounded-2xl border border-[#c8c0f7] shadow-2xl overflow-hidden max-h-[90vh] flex flex-col\"\n      >\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-[#e5e0f4] bg-[#f1ebff]\">\n          <div className=\"flex items-center gap-2\">\n            <User className=\"w-4 h-4 text-[#170065]\" />\n            <h2 id=\"profile-title\" className=\"text-base font-black text-[#09090D]\">\n              Student Academic Profile\n            </h2>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1 text-[#47464b] hover:text-[#09090D] hover:bg-[#ebe5fa] rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"p-6 overflow-y-auto space-y-4\">\n          <p className=\"text-xs text-[#5f5888]\">\n            Updating your academic details recalculates your match percentages and eligibility tags across all opportunities.\n          </p>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <div>\n              <label htmlFor=\"student-name\" className=\"block text-xs font-bold text-[#09090D] mb-1\">\n                Full Name\n              </label>\n              <input\n                id=\"student-name\"\n                type=\"text\"\n                required\n                value={formData.name}\n                onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                className=\"w-full p-2.5 text-xs bg-white border border-[#c8c5cb] focus:border-[#09090D] rounded-lg outline-none\"\n              />\n            </div>\n\n            <div>\n              <label htmlFor=\"student-college\" className=\"block text-xs font-bold text-[#09090D] mb-1\">\n                College / University\n              </label>\n              <input\n                id=\"student-college\"\n                type=\"text\"\n                value={formData.college}\n                onChange={(e) => setFormData({ ...formData, college: e.target.value })}\n                className=\"w-full p-2.5 text-xs bg-white border border-[#c8c5cb] rounded-lg outline-none\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <div>\n              <label htmlFor=\"student-branch\" className=\"block text-xs font-bold text-[#09090D] mb-1\">\n                Branch / Discipline\n              </label>\n              <select\n                id=\"student-branch\"\n                value={formData.branch}\n                onChange={(e) => setFormData({ ...formData, branch: e.target.value })}\n                className=\"w-full p-2.5 text-xs bg-white border border-[#c8c5cb] rounded-lg outline-none font-medium\"\n              >\n                <option value=\"Computer Science & Engineering\">Computer Science & Engineering (CSE)</option>\n                <option value=\"Information Technology\">Information Technology (IT)</option>\n                <option value=\"Electronics & Communication\">Electronics & Communication (ECE)</option>\n                <option value=\"Electrical Engineering\">Electrical Engineering (EE)</option>\n                <option value=\"Mechanical Engineering\">Mechanical Engineering</option>\n              </select>\n            </div>\n\n            <div>\n              <label htmlFor=\"student-cgpa\" className=\"block text-xs font-bold text-[#09090D] mb-1\">\n                Current CGPA (out of 10)\n              </label>\n              <input\n                id=\"student-cgpa\"\n                type=\"number\"\n                step=\"0.01\"\n                min=\"0\"\n                max=\"10\"\n                required\n                value={formData.cgpa}\n                onChange={(e) => setFormData({ ...formData, cgpa: parseFloat(e.target.value) || 0 })}\n                className=\"w-full p-2.5 text-xs font-mono-code font-bold bg-white border border-[#c8c5cb] focus:border-[#09090D] rounded-lg outline-none\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label htmlFor=\"student-backlogs\" className=\"block text-xs font-bold text-[#09090D] mb-1\">\n              Active Backlogs\n            </label>\n            <input\n              id=\"student-backlogs\"\n              type=\"number\"\n              min=\"0\"\n              value={formData.activeBacklogs}\n              onChange={(e) => setFormData({ ...formData, activeBacklogs: parseInt(e.target.value, 10) || 0 })}\n              className=\"w-full p-2.5 text-xs font-mono-code bg-white border border-[#c8c5cb] rounded-lg outline-none\"\n            />\n            <span className=\"text-[11px] text-[#78767b] mt-1 block\">\n              Most Tier-1 company cutoffs strictly require 0 active backlogs.\n            </span>\n          </div>\n\n          <div>\n            <label htmlFor=\"skills-input\" className=\"block text-xs font-bold text-[#09090D] mb-1\">\n              Skills (Press Enter to add)\n            </label>\n            <input\n              id=\"skills-input\"\n              type=\"text\"\n              value={skillInput}\n              onChange={(e) => setSkillInput(e.target.value)}\n              onKeyDown={handleAddSkill}\n              placeholder=\"e.g. Python, Docker, Go, DSA...\"\n              className=\"w-full p-2.5 text-xs bg-white border border-[#c8c5cb] rounded-lg outline-none mb-2\"\n            />\n            <div className=\"flex flex-wrap gap-1.5\">\n              {formData.skills.map((skill) => (\n                <span\n                  key={skill}\n                  className=\"inline-flex items-center gap-1 px-2.5 py-1 text-xs bg-[#e5deff] text-[#170065] rounded-md font-mono-code\"\n                >\n                  <span>{skill}</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => handleRemoveSkill(skill)}\n                    className=\"hover:text-red-600 text-xs font-bold\"\n                  >\n                    \303\227\n                  </button>\n                </span>\n              ))}\n            </div>\n          </div>\n\n          <div className=\"pt-3 border-t border-[#e5e0f4] flex justify-end gap-2\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 text-xs font-semibold text-[#47464b] hover:text-[#09090D]\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-5 py-2.5 text-xs font-bold bg-[#09090D] text-[#E3E0F2] rounded-lg shadow-xs nexora-btn-press\"\n            >\n              Save Profile & Recalculate\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
