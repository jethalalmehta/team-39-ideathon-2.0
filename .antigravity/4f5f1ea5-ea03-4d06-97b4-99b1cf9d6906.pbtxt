    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Opportunity, StudentProfile, ResumeGap, InterviewQuestion } from \'../types\';\nimport { sampleGapsForRole, sampleQuestionsForRole } from \'../data/mockData\';\nimport { FileText, ShieldAlert, Sparkles, ChevronDown, CheckCircle2, MessageSquare, ArrowRight, UploadCloud, RefreshCw } from \'lucide-react\';\n\ninterface ResumeGrillProps {\n  opportunities: Opportunity[];\n  selectedOpportunity: Opportunity | null;\n  onSelectOpportunity: (opp: Opportunity) => void;\n  student: StudentProfile;\n}\n\nexport const ResumeGrill: React.FC<ResumeGrillProps> = ({\n  opportunities,\n  selectedOpportunity,\n  onSelectOpportunity,\n  student,\n}) => {\n  const currentOpp = selectedOpportunity || opportunities[0];\n\n  const [activeQuestionIdx, setActiveQuestionIdx] = useState(0);\n  const [userAnswers, setUserAnswers] = useState<Record<string, string>>({});\n  const [showModelHints, setShowModelHints] = useState<Record<string, boolean>>({});\n  const [masteredQuestions, setMasteredQuestions] = useState<Record<string, boolean>>({});\n  const [isSimulatingAnalysis, setIsSimulatingAnalysis] = useState(false);\n\n  const gaps: ResumeGap[] = sampleGapsForRole.default;\n  const questions: InterviewQuestion[] = sampleQuestionsForRole.default;\n\n  const activeQuestion = questions[activeQuestionIdx] || questions[0];\n\n  const handleSimulateResumeReanalysis = () => {\n    setIsSimulatingAnalysis(true);\n    setTimeout(() => {\n      setIsSimulatingAnalysis(false);\n    }, 1200);\n  };\n\n  return (\n    <section className=\"py-8 sm:py-12 bg-[#fcf8ff]\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Section Header */}\n        <div className=\"mb-8\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-[#e5deff] border border-[#c8c0f7] rounded-full text-xs font-semibold text-[#170065] mb-2\">\n            <span>Interview Prep</span>\n            <span className=\"text-[#8174e5]\">\302\267</span>\n            <span>Resume Grill</span>\n          </div>\n          <h1 className=\"text-3xl sm:text-4xl font-black text-[#09090D] tracking-tight\">\n            Prepare for this job.\n          </h1>\n          <p className=\"text-sm sm:text-base text-[#47464b] mt-1 max-w-2xl\">\n            Spot your 3 biggest resume vulnerabilities before the interviewer does, then practice the exact technical and project questions they will ask.\n          </p>\n        </div>\n\n        {/* 4-Step Journey Header */}\n        <div className=\"bg-[#f1ebff] p-3 rounded-xl border border-[#d1c8ff] mb-8 grid grid-cols-2 md:grid-cols-4 gap-2 text-xs font-semibold text-[#5f5888]\">\n          <div className=\"flex items-center gap-2 text-[#09090D]\">\n            <span className=\"w-5 h-5 rounded-full bg-[#09090D] text-[#E3E0F2] flex items-center justify-center text-[10px]\">1</span>\n            <span>Select target job</span>\n          </div>\n          <div className=\"flex items-center gap-2 text-[#09090D]\">\n            <span className=\"w-5 h-5 rounded-full bg-[#09090D] text-[#E3E0F2] flex items-center justify-center text-[10px]\">2</span>\n            <span>Resume loaded</span>\n          </div>\n          <div className=\"flex items-center gap-2 text-[#09090D]\">\n            <span className=\"w-5 h-5 rounded-full bg-[#09090D] text-[#E3E0F2] flex items-center justify-center text-[10px]\">3</span>\n            <span>3 Biggest gaps</span>\n          </div>\n          <div className=\"flex items-center gap-2 text-[#170065] font-bold\">\n            <span className=\"w-5 h-5 rounded-full bg-[#170065] text-[#E3E0F2] flex items-center justify-center text-[10px]\">4</span>\n            <span>Interviewer questions</span>\n          </div>\n        </div>\n\n        {/* Top Controls: Job Picker & Resume Status */}\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-4 mb-8\">\n          {/* Target Job Selector (Spans 7) */}\n          <div className=\"md:col-span-7 bg-[#f1ebff] p-4 rounded-2xl border border-[#d1c8ff] flex flex-col justify-between\">\n            <div>\n              <label htmlFor=\"job-selector\" className=\"block text-[11px] font-bold uppercase tracking-wider text-[#5f5888] mb-1\">\n                Target Opportunity\n              </label>\n              <div className=\"relative\">\n                <select\n                  id=\"job-selector\"\n                  value={currentOpp.id}\n                  onChange={(e) => {\n                    const match = opportunities.find((o) => o.id === e.target.value);\n                    if (match) onSelectOpportunity(match);\n                  }}\n                  className=\"w-full bg-white border border-[#c8c5cb] rounded-xl px-4 py-2.5 text-xs font-bold text-[#09090D] appearance-none cursor-pointer focus:border-[#09090D] focus:ring-1 focus:ring-[#09090D] outline-none\"\n                >\n                  {opportunities.map((opp) => (\n                    <option key={opp.id} value={opp.id}>\n                      {opp.company} \342\200\224 {opp.role} ({opp.ctc})\n                    </option>\n                  ))}\n                </select>\n                <ChevronDown className=\"w-4 h-4 text-[#78767b] absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n              </div>\n            </div>\n\n            <div className=\"mt-3 pt-3 border-t border-[#d1c8ff]/60 flex items-center justify-between text-xs text-[#5f5888]\">\n              <span className=\"font-mono-code\">\n                {currentOpp.ctc} \302\267 {currentOpp.type}\n              </span>\n              <span className=\"font-semibold text-[#170065]\">\n                {currentOpp.matchScore}% Match Profile\n              </span>\n            </div>\n          </div>\n\n          {/* Student Active Resume (Spans 5) */}\n          <div className=\"md:col-span-5 bg-[#f1ebff] p-4 rounded-2xl border border-[#d1c8ff] flex flex-col justify-between\">\n            <div>\n              <span className=\"block text-[11px] font-bold uppercase tracking-wider text-[#5f5888] mb-1\">\n                Active Resume Profile\n              </span>\n              <div className=\"flex items-center gap-3 bg-white p-2.5 rounded-xl border border-[#e5e0f4]\">\n                <FileText className=\"w-5 h-5 text-[#170065] shrink-0\" />\n                <div className=\"min-w-0 flex-1\">\n                  <div className=\"text-xs font-bold text-[#09090D] truncate\">\n                    {student.resumeFileName}\n                  </div>\n                  <div className=\"text-[11px] text-[#78767b] font-mono-code\">\n                    {student.branch} \302\267 {student.cgpa} CGPA\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"mt-3 pt-3 border-t border-[#d1c8ff]/60 flex items-center justify-between\">\n              <span className=\"text-[11px] text-[#78767b]\">\n                Updated 2 days ago\n              </span>\n              <button\n                type=\"button\"\n                onClick={handleSimulateResumeReanalysis}\n                disabled={isSimulatingAnalysis}\n                className=\"text-[11px] font-semibold text-[#170065] hover:underline inline-flex items-center gap-1\"\n              >\n                <RefreshCw className={`w-3 h-3 ${isSimulatingAnalysis ? \'animate-spin\' : \'\'}`} />\n                <span>Re-analyze</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* SECTION 1: THE 3 BIGGEST GAPS */}\n        <div className=\"mb-12\">\n          <div className=\"flex items-center justify-between mb-4\">\n            <div>\n              <h2 className=\"text-xl sm:text-2xl font-black text-[#09090D] tracking-tight flex items-center gap-2\">\n                <ShieldAlert className=\"w-5 h-5 text-[#ba1a1a]\" />\n                <span>Your 3 Biggest Resume Gaps for {currentOpp.company}</span>\n              </h2>\n              <p className=\"text-xs text-[#5f5888] mt-0.5\">\n                Identified from the job requirements vs your listed projects. Fix these before your interview.\n              </p>\n            </div>\n            <span className=\"text-xs font-mono-code font-bold text-[#ba1a1a] bg-[#ffdad6] px-2.5 py-1 rounded-md hidden sm:inline\">\n              3 Gaps Flagged\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            {gaps.map((gap, idx) => (\n              <div\n                key={gap.id}\n                className=\"bg-[#f1ebff] border border-[#d1c8ff] rounded-2xl p-5 flex flex-col justify-between nexora-card-lift\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <span className=\"text-xs font-mono-code font-bold text-[#5f5888]\">\n                      Gap 0{idx + 1}\n                    </span>\n                    <span\n                      className={`text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded ${\n                        gap.severity === \'high\'\n                          ? \'bg-[#ffdad6] text-[#93000a]\'\n                          : \'bg-[#fff0c2] text-[#855300]\'\n                      }`}\n                    >\n                      {gap.severity} priority\n                    </span>\n                  </div>\n\n                  <h3 className=\"text-sm font-bold text-[#09090D] mb-2\">\n                    {gap.area}\n                  </h3>\n\n                  <p className=\"text-xs text-[#47464b] leading-relaxed mb-3\">\n                    {gap.description}\n                  </p>\n                </div>\n\n                <div className=\"mt-3 pt-3 border-t border-[#d1c8ff]/60 bg-white/70 p-3 rounded-xl border border-[#e5e0f4]\">\n                  <span className=\"text-[10px] font-bold text-[#170065] uppercase tracking-wider block mb-1\">\n                    Recommended Fix\n                  </span>\n                  <p className=\"text-xs font-medium text-[#1c1a28] leading-snug\">\n                    {gap.recommendation}\n                  </p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* SECTION 2: QUESTIONS AN INTERVIEWER IS LIKELY TO ASK YOU */}\n        <div>\n          <div className=\"mb-4\">\n            <h2 className=\"text-xl sm:text-2xl font-black text-[#09090D] tracking-tight flex items-center gap-2\">\n              <Sparkles className=\"w-5 h-5 text-[#7568D8]\" />\n              <span>Questions an interviewer is likely to ask you</span>\n            </h2>\n            <p className=\"text-xs text-[#5f5888] mt-0.5\">\n              Specific to {currentOpp.company} interview rounds and your project vulnerabilities.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n            {/* Question Selector List (Spans 4) */}\n            <div className=\"lg:col-span-4 space-y-2\">\n              {questions.map((q, idx) => {\n                const isActive = activeQuestionIdx === idx;\n                const isMastered = masteredQuestions[q.id];\n                return (\n                  <button\n                    key={q.id}\n                    onClick={() => setActiveQuestionIdx(idx)}\n                    className={`w-full text-left p-4 rounded-xl border transition-all flex items-start justify-between gap-3 ${\n                      isActive\n                        ? \'bg-[#09090D] text-[#E3E0F2] border-[#252332] shadow-md\'\n                        : \'bg-[#f1ebff] hover:bg-[#ebe5fa] text-[#1c1a28] border-[#d1c8ff]\'\n                    }`}\n                  >\n                    <div className=\"min-w-0 flex-1\">\n                      <div className=\"flex items-center gap-2 mb-1\">\n                        <span\n                          className={`text-[10px] font-mono-code uppercase font-bold px-1.5 py-0.5 rounded ${\n                            isActive\n                              ? \'bg-[#252332] text-[#C7BFEA]\'\n                              : \'bg-white text-[#5f5888]\'\n                          }`}\n                        >\n                          {q.category}\n                        </span>\n                        {isMastered && (\n                          <span className=\"text-[10px] font-bold text-[#10b981] flex items-center gap-0.5\">\n                            <CheckCircle2 className=\"w-3 h-3\" /> Mastered\n                          </span>\n                        )}\n                      </div>\n                      <p className={`text-xs font-bold line-clamp-2 ${isActive ? \'text-white\' : \'text-[#09090D]\'}`}>\n                        {q.question}\n                      </p>\n                    </div>\n\n                    <span className=\"text-xs opacity-50 shrink-0 font-mono-code\">\n                      0{idx + 1}\n                    </span>\n                  </button>\n                );\n              })}\n            </div>\n\n            {/* Active Question Focus Drill Console (Spans 8) */}\n            <div className=\"lg:col-span-8 bg-[#09090D] rounded-2xl p-6 sm:p-7 text-[#E3E0F2] border border-[#252332] shadow-xl flex flex-col justify-between\">\n              <div>\n                {/* Meta header */}\n                <div className=\"flex items-center justify-between pb-3 border-b border-[#252332] text-xs\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2 py-0.5 rounded bg-[#15151C] text-[#C7BFEA] border border-[#252332] font-mono-code font-bold\">\n                      {activeQuestion.category}\n                    </span>\n                    <span className=\"text-[#968DC8]\">\n                      Question {activeQuestionIdx + 1} of {questions.length}\n                    </span>\n                  </div>\n\n                  <button\n                    onClick={() => {\n                      setMasteredQuestions((prev) => ({\n                        ...prev,\n                        [activeQuestion.id]: !prev[activeQuestion.id],\n                      }));\n                    }}\n                    className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-xs font-semibold transition-colors ${\n                      masteredQuestions[activeQuestion.id]\n                        ? \'bg-[#10b981]/20 text-[#10b981] border border-[#10b981]/30\'\n                        : \'bg-[#15151C] text-[#968DC8] hover:text-[#E3E0F2] border border-[#252332]\'\n                    }`}\n                  >\n                    <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                    <span>{masteredQuestions[activeQuestion.id] ? \'Mastered\' : \'Mark as Mastered\'}</span>\n                  </button>\n                </div>\n\n                {/* Primary Question Statement */}\n                <div className=\"mt-4\">\n                  <h3 className=\"text-lg sm:text-xl font-bold text-white leading-snug\">\n                    \"{activeQuestion.question}\"\n                  </h3>\n                  <div className=\"mt-2 p-2.5 rounded-lg bg-[#15151C] border border-[#252332] text-xs text-[#c8c5cb]\">\n                    <span className=\"text-[#C7BFEA] font-semibold block mb-0.5\">\n                      Why the interviewer asks this:\n                    </span>\n                    <p>{activeQuestion.whyAsked}</p>\n                  </div>\n                </div>\n\n                {/* What to Cover / Model Blueprint */}\n                <div className=\"mt-4 space-y-2\">\n                  <span className=\"text-xs font-mono-code font-bold text-[#C7BFEA] uppercase tracking-wider block\">\n                    Key points to cover in your response:\n                  </span>\n                  <div className=\"space-y-1.5\">\n                    {activeQuestion.keyPointsToCover.map((point, pIdx) => (\n                      <div\n                        key={pIdx}\n                        className=\"flex items-start gap-2 text-xs text-[#E3E0F2] bg-[#15151C]/60 p-2 rounded-lg border border-[#252332]/50\"\n                      >\n                        <span className=\"text-[#7568D8] font-mono-code font-bold shrink-0\">\n                          {pIdx + 1}.\n                        </span>\n                        <span>{point}</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Interactive Practice Area */}\n                <div className=\"mt-4 pt-3 border-t border-[#252332]\">\n                  <label htmlFor=\"notes-input\" className=\"block text-xs font-mono-code text-[#968DC8] mb-1\">\n                    Your response notes / practice draft:\n                  </label>\n                  <textarea\n                    id=\"notes-input\"\n                    value={userAnswers[activeQuestion.id] || \'\'}\n                    onChange={(e) =>\n                      setUserAnswers((prev) => ({\n                        ...prev,\n                        [activeQuestion.id]: e.target.value,\n                      }))\n                    }\n                    placeholder=\"Draft your bullet points here (e.g. mention connection pooling, sliding window log, or STAR format)...\"\n                    rows={3}\n                    className=\"w-full p-2.5 text-xs bg-[#15151C] border border-[#252332] focus:border-[#7568D8] rounded-xl text-[#E3E0F2] placeholder:text-[#5f5e63] outline-none font-sans leading-relaxed\"\n                  />\n                </div>\n              </div>\n\n              {/* Bottom Pagination / Next Question */}\n              <div className=\"mt-5 pt-3 border-t border-[#252332] flex items-center justify-between text-xs\">\n                <span className=\"text-[#968DC8]\">\n                  {Object.keys(masteredQuestions).filter((k) => masteredQuestions[k]).length} of {questions.length} completed\n                </span>\n                <div className=\"flex gap-2\">\n                  {activeQuestionIdx > 0 && (\n                    <button\n                      onClick={() => setActiveQuestionIdx((prev) => prev - 1)}\n                      className=\"px-3 py-1.5 bg-[#15151C] hover:bg-[#252332] text-[#E3E0F2] rounded-lg border border-[#252332]\"\n                    >\n                      Previous\n                    </button>\n                  )}\n                  {activeQuestionIdx < questions.length - 1 ? (\n                    <button\n                      onClick={() => setActiveQuestionIdx((prev) => prev + 1)}\n                      className=\"px-4 py-1.5 bg-[#252332] hover:bg-[#3A364E] text-white rounded-lg font-bold inline-flex items-center gap-1\"\n                    >\n                      <span>Next question</span>\n                      <ArrowRight className=\"w-3.5 h-3.5\" />\n                    </button>\n                  ) : (\n                    <button\n                      onClick={() => setActiveQuestionIdx(0)}\n                      className=\"px-4 py-1.5 bg-[#252332] text-white rounded-lg font-bold\"\n                    >\n                      Back to first\n                    </button>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
