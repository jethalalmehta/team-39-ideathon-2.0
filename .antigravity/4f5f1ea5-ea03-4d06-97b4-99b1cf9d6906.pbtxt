      replacement_content: "import React, { useState } from \'react\';\nimport { ProgressSummary, RejectionRecord } from \'../types\';\nimport { initialRejections, initialProgress } from \'../data/mockData\';\nimport { HeartHandshake, Lightbulb, Target, Plus, CheckCircle, ArrowRight, ShieldCheck } from \'lucide-react\';\n\ninterface ProgressPageProps {\n  onStartAptitudePractice?: () => void;\n  onNavigateToPrepare?: () => void;\n}\n\nexport const ProgressPage: React.FC<ProgressPageProps> = ({\n  onStartAptitudePractice,\n  onNavigateToPrepare,\n}) => {\n  const [progress, setProgress] = useState<ProgressSummary>(initialProgress);\n  const [rejections, setRejections] = useState<RejectionRecord[]>(initialRejections);\n  const [showLogModal, setShowLogModal] = useState(false);\n  const [newCompany, setNewCompany] = useState(\'\');\n  const [newStage, setNewStage] = useState<\'Aptitude / Online Test\' | \'Technical Round 1\' | \'Technical Round 2\' | \'HR Round\'>(\'Aptitude / Online Test\');\n  const [newNote, setNewNote] = useState(\'\');\n  const [loggedNotification, setLoggedNotification] = useState(false);\n\n  const handleAddLog = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newCompany.trim()) return;\n\n    const newRecord: RejectionRecord = {\n      id: `rej-${Date.now()}`,\n      company: newCompany.trim(),\n      role: \'Graduate Software Engineer\',\n      stage: newStage,\n      date: \'Just now\',\n      primaryCause: newNote.trim() || \'Speed on timed problem solving\',\n      takeaway: \'Focus practice on the bottleneck segment.\',\n    };\n\n    setRejections([newRecord, ...rejections]);\n    setProgress((prev) => ({\n      ...prev,\n      rejections: prev.rejections + 1,\n    }));\n    setNewCompany(\'\');\n    setNewNote(\'\');\n    setShowLogModal(false);\n    setLoggedNotification(true);\n    setTimeout(() => setLoggedNotification(false), 3000);\n  };\n\n  return (\n    <section className=\"py-8 sm:py-12 bg-[#fcf8ff]\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Section Header */}\n        <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 bg-[#e5deff] border border-[#c8c0f7] rounded-full text-xs font-semibold text-[#170065] mb-2\">\n              <span>Placement Tracker</span>\n              <span className=\"text-[#8174e5]\">\302\267</span>\n              <span>Constructive Insights</span>\n            </div>\n            <h1 className=\"text-3xl sm:text-4xl font-black text-[#09090D] tracking-tight\">\n              Learn from the rejection.\n            </h1>\n            <p className=\"text-sm sm:text-base text-[#47464b] mt-1 max-w-xl\">\n              Track applications cleanly. Every rejection is just data to fix the next interview.\n            </p>\n          </div>\n\n          <button\n            onClick={() => setShowLogModal(true)}\n            className=\"self-start sm:self-auto inline-flex items-center gap-2 px-4 py-2.5 bg-[#09090D] hover:bg-[#1b1b1f] text-[#E3E0F2] text-xs font-bold rounded-lg nexora-btn-press transition-colors shadow-xs\"\n          >\n            <Plus className=\"w-4 h-4 text-[#7568D8]\" />\n            <span>Log an outcome</span>\n          </button>\n        </div>\n\n        {loggedNotification && (\n          <div className=\"mb-6 p-3 bg-[#e5deff] border border-[#c8c0f7] rounded-xl text-xs text-[#170065] font-semibold flex items-center justify-between animate-in fade-in\">\n            <span className=\"flex items-center gap-1.5\">\n              <CheckCircle className=\"w-4 h-4 text-[#10b981]\" />\n              Outcome logged. Nexora updated your diagnostic pattern below.\n            </span>\n          </div>\n        )}\n\n        {/* 1. SIMPLE 4-METRIC TILES */}\n        <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-8\">\n          {/* Applications */}\n          <div className=\"bg-[#f1ebff] border border-[#d1c8ff] rounded-2xl p-5 nexora-card-lift\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#5f5888] block\">\n              Applications\n            </span>\n            <div className=\"text-3xl sm:text-4xl font-black text-[#09090D] font-mono-code tabular-nums mt-1\">\n              {progress.applications}\n            </div>\n            <span className=\"text-[11px] text-[#78767b] mt-1 block\">\n              Sent through campus drives\n            </span>\n          </div>\n\n          {/* Interviews */}\n          <div className=\"bg-[#f1ebff] border border-[#d1c8ff] rounded-2xl p-5 nexora-card-lift\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#5f5888] block\">\n              Interviews\n            </span>\n            <div className=\"text-3xl sm:text-4xl font-black text-[#170065] font-mono-code tabular-nums mt-1\">\n              {progress.interviews}\n            </div>\n            <span className=\"text-[11px] text-[#78767b] mt-1 block\">\n              Rounds reached\n            </span>\n          </div>\n\n          {/* Offers */}\n          <div className=\"bg-[#f1ebff] border border-[#c8c0f7] rounded-2xl p-5 nexora-card-lift\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#170065] block\">\n              Offers\n            </span>\n            <div className=\"text-3xl sm:text-4xl font-black text-[#09090D] font-mono-code tabular-nums mt-1\">\n              {progress.offers}\n            </div>\n            <span className=\"text-[11px] text-[#5f5888] font-medium mt-1 block\">\n              Campus offer in hand\n            </span>\n          </div>\n\n          {/* Rejections */}\n          <div className=\"bg-[#f1ebff] border border-[#d1c8ff] rounded-2xl p-5 nexora-card-lift\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-[#5f5888] block\">\n              Rejections\n            </span>\n            <div className=\"text-3xl sm:text-4xl font-black text-[#47464b] font-mono-code tabular-nums mt-1\">\n              {progress.rejections}\n            </div>\n            <span className=\"text-[11px] text-[#78767b] mt-1 block\">\n              Opportunities to learn from\n            </span>\n          </div>\n        </div>\n\n        {/* 2. EMOTIONALLY FRIENDLY REJECTION AUTOPSY CARD */}\n        <div className=\"bg-[#09090D] text-[#E3E0F2] rounded-2xl p-6 sm:p-8 border border-[#252332] shadow-xl mb-12\">\n          <div className=\"flex items-center gap-2 mb-4 text-[#C7BFEA]\">\n            <HeartHandshake className=\"w-5 h-5 text-[#7568D8]\" />\n            <span className=\"text-xs font-bold uppercase tracking-wider\">\n              Diagnostic Autopsy \302\267 Emotionally Supportive Insights\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8 items-center\">\n            {/* Left: Your Biggest Pattern */}\n            <div className=\"space-y-3\">\n              <span className=\"text-xs font-mono-code font-bold text-[#968DC8] uppercase tracking-wider\">\n                {progress.biggestPattern.headline}\n              </span>\n              <h2 className=\"text-2xl sm:text-3xl font-black text-white leading-tight\">\n                \"{progress.biggestPattern.description}\"\n              </h2>\n              <p className=\"text-xs sm:text-sm text-[#c8c5cb] leading-relaxed\">\n                This is good news: your core programming and resume get you shortlisted. You are losing out on timed aptitude test speed, which is the easiest part to fix with repetitive drills.\n              </p>\n            </div>\n\n            {/* Right: What to do next */}\n            <div className=\"bg-[#15151C] border border-[#252332] rounded-xl p-5 space-y-3\">\n              <div className=\"flex items-center gap-2 text-xs font-mono-code font-bold text-[#7568D8] uppercase tracking-wider\">\n                <Target className=\"w-4 h-4\" />\n                <span>{progress.nextFocus.title}</span>\n              </div>\n              <h3 className=\"text-lg font-bold text-white\">\n                \"{progress.nextFocus.action}\"\n              </h3>\n              <p className=\"text-xs text-[#c8c5cb]\">\n                {progress.nextFocus.suggestedDrill}\n              </p>\n\n              <div className=\"pt-2\">\n                <button\n                  onClick={onNavigateToPrepare}\n                  className=\"w-full py-2.5 px-4 bg-[#E3E0F2] hover:bg-white text-[#09090D] font-bold text-xs rounded-lg transition-colors flex items-center justify-center gap-2\"\n                >\n                  <span>Practice in Resume Grill</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          </div>\n\n          {/* Simple Visual Trend Underneath */}\n          <div className=\"mt-8 pt-6 border-t border-[#252332]\">\n            <span className=\"text-xs font-mono-code text-[#968DC8] uppercase tracking-wider block mb-2\">\n              Where your rejections occurred:\n            </span>\n            <div className=\"space-y-2\">\n              <div className=\"h-4 w-full bg-[#15151C] rounded-full overflow-hidden flex\">\n                <div\n                  className=\"bg-[#7568D8] h-full\"\n                  style={{ width: \'60%\' }}\n                  title=\"Aptitude (60%)\"\n                />\n                <div\n                  className=\"bg-[#5f5888] h-full\"\n                  style={{ width: \'25%\' }}\n                  title=\"Tech Round 1 (25%)\"\n                />\n                <div\n                  className=\"bg-[#3A364E] h-full\"\n                  style={{ width: \'15%\' }}\n                  title=\"Tech Round 2 (15%)\"\n                />\n              </div>\n\n              <div className=\"flex flex-wrap items-center justify-between text-[11px] text-[#c8c5cb] pt-1\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-[#7568D8]\" />\n                  <span>Aptitude / Online Tests: <strong>3 drives</strong></span>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-[#5f5888]\" />\n                  <span>Technical Round 1: <strong>1 drive</strong></span>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-[#3A364E]\" />\n                  <span>Technical Round 2: <strong>1 drive</strong></span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* 3. REJECTION TIMELINE & LESSONS */}\n        <div>\n          <div className=\"mb-4\">\n            <h2 className=\"text-xl sm:text-2xl font-black text-[#09090D] tracking-tight\">\n              Past Drive Outcomes & Lessons\n            </h2>\n            <p className=\"text-xs text-[#5f5888] mt-0.5\">\n              Clear takeaways documented from each interview loop.\n            </p>\n          </div>\n\n          <div className=\"space-y-3\">\n            {rejections.map((rej) => (\n              <div\n                key={rej.id}\n                className=\"bg-[#f1ebff] border border-[#d1c8ff] rounded-xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 nexora-card-lift\"\n              >\n                <div className=\"space-y-1\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-sm font-bold text-[#09090D]\">\n                      {rej.company}\n                    </span>\n                    <span className=\"text-xs text-[#78767b]\">\302\267</span>\n                    <span className=\"text-xs text-[#47464b] font-medium\">\n                      {rej.role}\n                    </span>\n                    <span className=\"text-xs text-[#78767b]\">\302\267</span>\n                    <span className=\"text-xs font-mono-code text-[#5f5888] bg-white px-2 py-0.5 rounded border border-[#d1c8ff]\">\n                      {rej.stage}\n                    </span>\n                  </div>\n\n                  <p className=\"text-xs text-[#47464b]\">\n                    <strong>Bottleneck:</strong> {rej.primaryCause}\n                  </p>\n\n                  <p className=\"text-xs text-[#170065] font-semibold\">\n                    \342\234\223 Takeaway: {rej.takeaway}\n                  </p>\n                </div>\n\n                <div className=\"text-right shrink-0\">\n                  <span className=\"text-xs text-[#78767b] font-mono-code block\">\n                    {rej.date}\n                  </span>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* LOG OUTCOME MODAL */}\n        {showLogModal && (\n          <div\n            className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#09090D]/60 backdrop-blur-xs animate-in fade-in\"\n            onClick={() => setShowLogModal(false)}\n            role=\"dialog\"\n            aria-modal=\"true\"\n          >\n            <div\n              onClick={(e) => e.stopPropagation()}\n              className=\"w-full max-w-md bg-[#fcf8ff] rounded-2xl border border-[#c8c0f7] p-6 shadow-2xl space-y-4\"\n            >\n              <h3 className=\"text-lg font-black text-[#09090D]\">\n                Log an Outcome\n              </h3>\n              <p className=\"text-xs text-[#5f5888]\">\n                Add any test or interview you did not clear so Nexora can update your improvement focus.\n              </p>\n\n              <form onSubmit={handleAddLog} className=\"space-y-3\">\n                <div>\n                  <label htmlFor=\"company-name\" className=\"block text-xs font-bold text-[#09090D] mb-1\">\n                    Company Name\n                  </label>\n                  <input\n                    id=\"company-name\"\n                    type=\"text\"\n                    required\n                    value={newCompany}\n                    onChange={(e) => setNewCompany(e.target.value)}\n                    placeholder=\"e.g. Swiggy, Goldman Sachs, TCS\"\n                    className=\"w-full p-2.5 text-xs bg-white border border-[#c8c5cb] rounded-lg outline-none focus:border-[#09090D]\"\n                  />\n                </div>\n\n                <div>\n                  <label htmlFor=\"eliminated-stage\" className=\"block text-xs font-bold text-[#09090D] mb-1\">\n                    Stage eliminated\n                  </label>\n                  <select\n                    id=\"eliminated-stage\"\n                    value={newStage}\n                    onChange={(e) => setNewStage(e.target.value as any)}\n                    className=\"w-full p-2.5 text-xs bg-white border border-[#c8c5cb] rounded-lg outline-none\"\n                  >\n                    <option value=\"Aptitude / Online Test\">Aptitude / Online Test</option>\n                    <option value=\"Technical Round 1\">Technical Round 1</option>\n                    <option value=\"Technical Round 2\">Technical Round 2</option>\n                    <option value=\"HR Round\">HR Round</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label htmlFor=\"what-happened-notes\" className=\"block text-xs font-bold text-[#09090D] mb-1\">\n                    What felt difficult? (Optional)\n                  </label>\n                  <input\n                    id=\"what-happened-notes\"\n                    type=\"text\"\n                    value={newNote}\n                    onChange={(e) => setNewNote(e.target.value)}\n                    placeholder=\"e.g. Ran out of time on quant section\"\n                    className=\"w-full p-2.5 text-xs bg-white border border-[#c8c5cb] rounded-lg outline-none\"\n                  />\n                </div>\n\n                <div className=\"pt-2 flex justify-end gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setShowLogModal(false)}\n                    className=\"px-4 py-2 text-xs font-semibold text-[#47464b] hover:text-[#09090D]\"\n                  >\n                    Cancel\n                  </button>\n                  <button\n                    type=\"submit\"\n                    className=\"px-5 py-2 text-xs font-bold bg-[#09090D] text-[#E3E0F2] rounded-lg shadow-xs\"\n                  >\n                    Save & Update\n                  </button>\n                </div>\n              </form>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n};\n"
    }
