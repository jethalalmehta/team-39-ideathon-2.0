      original_chunk {
        target_content: "import { Opportunity, StudentProfile, ResumeGap, InterviewMCQ, RejectionRecord, ProgressSummary, CompanyListing } from \'../types\';\n\nexport const initialStudentProfile: StudentProfile = {\n  name: \'Aman Sharma\',\n  email: \'aman.sharma22@nitj.ac.in\',\n  college: \'National Institute of Technology, Jalandhar\',\n  degree: \'B.Tech\',\n  branch: \'Computer Science & Engineering\',\n  graduationYear: 2026,\n  cgpa: 7.8,\n  activeBacklogs: 0,\n  skills: [\'Python\', \'Data Structures & Algorithms\', \'React\', \'SQL\', \'Node.js\', \'FastAPI\'],\n  resumeFileName: \'Aman_Sharma_CSE_Resume_2026.pdf\',\n};\n\nexport const sampleNotices = [\n  {\n    title: \'Microsoft India \342\200\224 SWE Intern 2026\',\n    text: `URGENT NOTICE: T&P CELL / 2026 BATCH\nCompany: Microsoft India R&D Pvt Ltd\nRole: Software Engineering Intern (Summer 2026)\nStipend: \342\202\2711,25,000 / month + accommodation\nEligible Branches: CSE, IT, ECE with CGPA >= 7.5 (No active backlogs)\nLocation: Hyderabad / Bengaluru\nRounds:\n1. Online Assessment (DSA + Debugging on HackerEarth - 90 mins)\n2. Technical Interview 1 (Data Structures, Algorithms & OS)\n3. Technical Interview 2 (System Design basics & Projects)\n4. AA / HR Round\nApplication Deadline: 12th Oct 2026, 11:59 PM.\nRegister on campus portal before deadline. Late submissions will strictly not be entertained.`,\n  },\n  {\n    title: \'Razorpay \342\200\224 Graduate Software Engineer\',\n    text: `CAMPUS PLACEMENT CIRCULAR \342\200\224 RAZORPAY\nRole: Software Engineer (Full-Time)\nEligibility Criteria:\n- B.Tech CSE, IT, ECE (2026 Passing Out)\n- Minimum 7.0 CGPA throughout 10th, 12th & Graduation\n- Compensation: \342\202\27118.5 LPA (15 LPA Fixed + Joining Bonus + ESOPs)\nSelection Procedure:\n1. Online Technical Assessment (Coding + CS Fundamentals)\n2. Technical Round 1 (Problem Solving & Coding in Java/Go/Python)\n3. Technical Round 2 (Low Level Design & Past Projects)\n4. Bar Raiser Round\nDeadline 